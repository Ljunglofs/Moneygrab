color  colDn     = input.color(color.new(#ff2e88, 0), "Short", group = G_V)

// ════════════════════════ TYP ════════════════════════
type Node
    float price
    float top
    float bot
    float vol
    float share
    float timeAt     //  antal intrabar-celler som rörde raden ("time at price")
    float strengthPct//  nodstyrka i procent: radens volym / profilens volym
    float buyPct
    int   row
    int   kind       //  1 = POC/HVN,  -1 = POV/LVN
    bool  isPoc
    bool  dev        //  true = hämtad ur den pågående profilen
    int   bornBar
    int   touches
    int   side       //  senast kända sida:  1 = priset över,  -1 = under,  0 = inuti
    int   fromSide   //  sidan interaktionen inleddes från
    bool  inside     //  en interaktion pågår
    bool  active
    float strength
    line  ln
    box   bx
    label lb

// ════════════════════════ HJÄLPARE ════════════════════════
// Value area enligt TradingViews metod: väx ut från POC, två rader i taget,
// åt det håll som bär mest volym, tills andelen är uppnådd.
f_va(array<float> bk, int poc, float tot, float frac) =>
    int nR = array.size(bk)
    float acc = array.get(bk, poc)
    int up = poc
    int dn = poc
    int guard = 0
    while acc < tot * frac and (up < nR - 1 or dn > 0) and guard < nR
        guard += 1
        float vUp = 0.0
        int   nUp = 0
        if up + 1 <= nR - 1
            vUp += array.get(bk, up + 1)
            nUp := 1
            if up + 2 <= nR - 1
                vUp += array.get(bk, up + 2)
                nUp := 2
        float vDn = 0.0
        int   nDn = 0
        if dn - 1 >= 0
            vDn += array.get(bk, dn - 1)
            nDn := 1
            if dn - 2 >= 0
                vDn += array.get(bk, dn - 2)
                nDn := 2
        if nUp > 0 and (nDn == 0 or vUp >= vDn)
            up += nUp
            acc += vUp
        else if nDn > 0
            dn -= nDn
            acc += vDn
        else
            break
    [up, dn]

f_smooth(array<float> bk, int n) =>
    out = array.copy(bk)
    if n > 0
        int sz = array.size(bk)
        for j = 0 to sz - 1
            float acc = 0.0
            int   cnt = 0
            for q = math.max(0, j - n) to math.min(sz - 1, j + n)
                acc += array.get(bk, q)
                cnt += 1
            array.set(out, j, acc / cnt)
    out

// Bygger histogrammet ur de ackumulerade cellerna [0, nUse-1].
// Inga historiska referenser här inne — allt kommer in som arrayer.
f_profile(array<float> aHi, array<float> aLo, array<float> aVol, array<float> aBuy, int nUse, int nRows) =>
    float hh = na
    float ll = na
    if nUse > 0
        for i = 0 to nUse - 1
            float h = array.get(aHi, i)
            float l = array.get(aLo, i)
            hh := na(hh) ? h : math.max(hh, h)
            ll := na(ll) ? l : math.min(ll, l)
    bk  = array.new_float(nRows, 0.0)
    bbk = array.new_float(nRows, 0.0)
    tbk = array.new_float(nRows, 0.0)
    float step = 0.0
    float totV = 0.0
    float totB = 0.0
    if not na(hh) and hh > ll
        step := (hh - ll) / nRows
        for i = 0 to nUse - 1
            float h = array.get(aHi, i)
            float l = array.get(aLo, i)
            float v = array.get(aVol, i)
            float b = array.get(aBuy, i)
            int j0 = math.max(0, math.min(nRows - 1, int(math.floor((l - ll) / step))))
            int j1 = math.max(0, math.min(nRows - 1, int(math.floor((h - ll) / step))))
            int sp = j1 - j0 + 1
            for j = j0 to j1
                array.set(bk,  j, array.get(bk,  j) + v / sp)
                array.set(bbk, j, array.get(bbk, j) + b / sp)
                array.set(tbk, j, array.get(tbk, j) + 1)
            totV += v
            totB += b
    [ll, step, bk, bbk, tbk, totV, totB, hh]

f_poc(array<float> bk) =>
    int   idx = 0
    float mx  = 0.0
    for j = 0 to array.size(bk) - 1
        float v = array.get(bk, j)
        if v > mx
            mx  := v
            idx := j
    [idx, mx]

f_topN(array<Node> src, int n) =>
    out = array.new<Node>()
    tmp = array.copy(src)
    while array.size(out) < n and array.size(tmp) > 0
        int   bi = 0
        float bs = -1.0
        for i = 0 to array.size(tmp) - 1
            Node c = array.get(tmp, i)
            if c.strength > bs
                bs := c.strength
                bi := i
        array.push(out, array.remove(tmp, bi))
    out

// ── NODSTYRKA ──────────────────────────────────────────────────────────────
// Node Strength % = radens volym delat med profilens totala volym. Samma mått
// som förlagan redovisar i sina tooltips, "Node Strength % (POC/Total)".
// Talet beror på hur många rader profilen har, så filtret använder i stället
// samma storhet uttryckt som koncentration: hur många gånger tätare raden är
// än en jämn fördelning. 1.0 = ingen koncentration alls.
//
// POV = Point of Void: den tunnaste raden INNE i värdeområdet. Generiska LVN
// kan ligga var som helst i profilen, även ute i de tunnhandlade extremerna,
// där tunnheten bara betyder att priset var där en enda gång. POV isolerar det
// tunna stället inuti fair value. Det är hela skillnaden mellan en nod som
// betyder något och profilens golv.
f_mkNodes(array<float> bk, array<float> bbk, array<float> tbk, float lo, float step, float totV,
     int pocIdx, int vahIdx, int valIdx, int nRows, int bornBar, float px, bool isDev) =>
    out = array.new<Node>()
    if totV > 0 and step > 0
        sm = f_smooth(bk, smoothN)
        float mx = 0.0
        for j = 0 to nRows - 1
            mx := math.max(mx, array.get(sm, j))
        if mx > 0
            int halfB = math.max(1, int(math.round(nodeSep / 2.0)))
            hvn = array.new<Node>()
            // ── POC / HVN: lokala toppar i histogrammet ──
            for j = 0 to nRows - 1
                float v = array.get(sm, j)
                bool isMax = true
                for q = math.max(0, j - nodeSep) to math.min(nRows - 1, j + nodeSep)
                    float w = array.get(sm, q)
                    if w > v or (w == v and q < j)
                        isMax := false
                if isMax and v >= hvnPct * mx
                    int r0 = math.max(0, j - halfB)
                    int r1 = math.min(nRows - 1, j + halfB)
                    float nv = 0.0
                    float nb = 0.0
                    float nt = 0.0
                    for q = r0 to r1
                        nv += array.get(bk, q)
                        nb += array.get(bbk, q)
                        nt += array.get(tbk, q)
                    float price = lo + (j + 0.5) * step
                    float half  = math.max(step * 0.5, step * halfB * (1.0 + (pocMargin ? pocDist : 0.0)))
                    array.push(hvn, Node.new(price = price, top = price + half, bot = price - half,
                         vol = array.get(bk, j), share = nv / totV, timeAt = nt,
                         strengthPct = 100 * array.get(bk, j) / totV,
                         buyPct = nv > 0 ? 100 * nb / nv : 50.0, row = j, kind = 1, isPoc = false,
                         dev = isDev, bornBar = bornBar, touches = 0,
                         side = px > price + half ? 1 : px < price - half ? -1 : 0,
                         fromSide = 0, inside = false, active = true,
                         strength = array.get(bk, j) / totV * nRows))
            topH = f_topN(hvn, maxHvn)
            int bestI = -1
            int bestD = 999999
            for i = 0 to array.size(topH) - 1
                Node c = array.get(topH, i)
                int d = math.abs(c.row - pocIdx)
                if d < bestD
                    bestD := d
                    bestI := i
            if bestI >= 0
                Node pnode = array.get(topH, bestI)
                pnode.isPoc := true
            for c in topH
                array.push(out, c)
            // ── POV: tunnaste raden inuti värdeområdet ──
            if povOn and vahIdx > valIdx
                int   vi = -1
                float vv = 0.0
                for j = valIdx to vahIdx
                    float w = array.get(sm, j)
                    if vi < 0 or w < vv
                        vv := w
                        vi := j
                if vi >= 0
                    int r0 = math.max(0, vi - halfB)
                    int r1 = math.min(nRows - 1, vi + halfB)
                    float nv = 0.0
                    float nb = 0.0
                    float nt = 0.0
                    for q = r0 to r1
                        nv += array.get(bk, q)
                        nb += array.get(bbk, q)
                        nt += array.get(tbk, q)
                    float price = lo + (vi + 0.5) * step
                    float half  = math.max(step * 0.5, step * halfB * (1.0 + (povMargin ? povDist : 0.0)))
                    array.push(out, Node.new(price = price, top = price + half, bot = price - half,
                         vol = array.get(bk, vi), share = nv / totV, timeAt = nt,
                         strengthPct = 100 * array.get(bk, vi) / totV,
                         buyPct = nv > 0 ? 100 * nb / nv : 50.0, row = vi, kind = -1, isPoc = false,
                         dev = isDev, bornBar = bornBar, touches = 0,
                         side = px > price + half ? 1 : px < price - half ? -1 : 0,
                         fromSide = 0, inside = false, active = true,
                         strength = mx > 0 ? 1.0 - vv / mx : 0.0))
    out

// ════════════════════════ DATA ════════════════════════
int    tfSec  = timeframe.in_seconds()
string ltfRes = ltfMode == "Av" ? timeframe.period : ltfMode == "1" ? "1" : ltfMode == "5" ? "5" : (tfSec >= 3600 ? "5" : tfSec > 60 ? "1" : timeframe.period)
[ltfH, ltfL, ltfV, ltfC] = request.security_lower_tf(syminfo.tickerid, ltfRes, [high, low, volume, close])

float atr   = ta.atr(atrLen)
float vwapV = ta.vwap(hlc3)
float rng  = high - low
float upWk = high - math.max(open, close)
float dnWk = math.min(open, close) - low

// Alla medelvärden beräknas ovillkorligt — ta.* får inte sitta bakom en gren.
float baseMa = ta.ema(close, emaLen)
float mSma = ta.sma(baseMa, smLen)
float mEma = ta.ema(baseMa, smLen)
float mRma = ta.rma(baseMa, smLen)
float mWma = ta.wma(baseMa, smLen)
float trend = smType == "SMA" ? mSma : smType == "RMA" ? mRma : smType == "WMA" ? mWma : mEma

int  sigSessT  = time(timeframe.period, sigSess, sessTz)
bool sessOk    = not sessFilt or (sessMode == "Inuti" ? not na(sigSessT) : na(sigSessT))
bool momOk     = not momGuard or rng <= atrMult * atr

int  profSessT = time(timeframe.period, profSess, sessTz)
bool newSessB  = profType == "Session" and not na(profSessT) and na(profSessT[1])

// ── Ackumulerade profilceller (kapas av Bars Scan) ──
var array<float> cHi  = array.new_float()
var array<float> cLo  = array.new_float()
var array<float> cVol = array.new_float()
var array<float> cBuy = array.new_float()
var array<int>   cBar = array.new_int()
int maxCells = barsScan * 6

f_pushCell(float h, float l, float v, float c) =>
    float r = h - l
    array.push(cHi,  h)
    array.push(cLo,  l)
    array.push(cVol, v)
    array.push(cBuy, r > 0 ? v * (c - l) / r : v * 0.5)
    array.push(cBar, bar_index)

// ════════════════════════ SEGMENTERING ════════════════════════
var int   segStart  = na
var int   lastPivD  = 0
var float segStartP = na

float ph = ta.pivothigh(swWidth, swWidth)
float pl = ta.pivotlow(swWidth, swWidth)

bool closeNow = false
int  cutBar   = na

if na(segStart)
    segStart  := bar_index
    segStartP := open

if profType == "Session"
    if newSessB and bar_index > segStart
        closeNow := true
        cutBar   := bar_index - 1
else
    int d = not na(ph) ? 1 : not na(pl) ? -1 : 0
    if d != 0
        int pivBar = bar_index - swWidth
        if d != lastPivD and lastPivD != 0 and pivBar > segStart
            closeNow := true
            cutBar   := pivBar
        if d != lastPivD
            lastPivD := d

// ════════════════════════ NODER ════════════════════════
var array<Node> nodes   = array.new<Node>()
var array<int>  profIds = array.new_int()
var float lastPoc  = na
var float lastVah  = na
var float lastVal  = na
var float lastPov  = na
var float lastBuyP = na
var float lastPocB = na
var float lastNS   = na
var float lastChg  = na

f_dropNode(Node n) =>
    line.delete(n.ln)
    box.delete(n.bx)
    label.delete(n.lb)

f_trimProfiles() =>
    while array.size(profIds) > keepProf
        int gone = array.shift(profIds)
        if array.size(nodes) > 0
            for i = array.size(nodes) - 1 to 0
                Node n = array.get(nodes, i)
                if n.bornBar == gone and not n.dev
                    f_dropNode(n)
                    array.remove(nodes, i)

if closeNow and not na(cutBar)
    // dela cellerna vid cutBar: prefixet tillhör profilen som stänger
    int nUse = 0
    int nAll = array.size(cBar)
    if nAll > 0
        for i = 0 to nAll - 1
            if array.get(cBar, i) <= cutBar
                nUse := i + 1
            else
                break
    if nUse > 10
        [plo, pstep, pbk, pbbk, ptbk, ptot, pbuy, phi] = f_profile(cHi, cLo, cVol, cBuy, nUse, rows)
        if ptot > 0 and pstep > 0
            [pidx, pmax] = f_poc(pbk)
            [vahI, valI] = f_va(pbk, pidx, ptot, vaPct)
            int  back   = math.max(0, bar_index - cutBar)
            float endPx = close[back]
            lastPoc  := plo + (pidx + 0.5) * pstep
            lastVah  := plo + (vahI + 1) * pstep
            lastVal  := plo + valI * pstep
            lastBuyP := 100 * pbuy / ptot
            lastPocB := array.get(pbk, pidx) > 0 ? 100 * array.get(pbbk, pidx) / array.get(pbk, pidx) : 50.0
            lastNS   := 100 * array.get(pbk, pidx) / ptot
            lastChg  := na(segStartP) or segStartP == 0 ? na : 100 * (endPx - segStartP) / segStartP
            fresh = f_mkNodes(pbk, pbbk, ptbk, plo, pstep, ptot, pidx, vahI, valI, rows, cutBar, close, false)
            float povP = na
            for n in fresh
                array.push(nodes, n)
                if n.kind == -1 and na(povP)
                    povP := n.price
            lastPov := povP
            if array.size(fresh) > 0
                array.push(profIds, cutBar)
                f_trimProfiles()
            segStartP := endPx
    if nUse > 0
        for i = 1 to nUse
            array.shift(cHi)
            array.shift(cLo)
            array.shift(cVol)
            array.shift(cBuy)
            array.shift(cBar)
    segStart := cutBar

// ── Ackumulera den här barens celler ──
int nK = array.size(ltfV)
if nK > 0 and ltfMode != "Av"
    for k = 0 to nK - 1
        f_pushCell(array.get(ltfH, k), array.get(ltfL, k), array.get(ltfV, k), array.get(ltfC, k))
else
    f_pushCell(high, low, nz(volume), close)

while array.size(cVol) > maxCells
    array.shift(cHi)
    array.shift(cLo)
    array.shift(cVol)
    array.shift(cBuy)
    array.shift(cBar)

// ── Pågående profil som nodkälla (ritar om — se filhuvudet) ──
if profWin == "Pågående" and barstate.isconfirmed and array.size(cVol) > 10 and bar_index % 5 == 0
    if array.size(nodes) > 0
        for i = array.size(nodes) - 1 to 0
            Node n = array.get(nodes, i)
            if n.dev
                f_dropNode(n)
                array.remove(nodes, i)
    [xlo, xstep, xbk, xbbk, xtbk, xtot, xbuy, xhi] = f_profile(cHi, cLo, cVol, cBuy, array.size(cVol), rows)
    if xtot > 0 and xstep > 0
        [xidx, xmax] = f_poc(xbk)
        [xvah, xval] = f_va(xbk, xidx, xtot, vaPct)
        devFresh = f_mkNodes(xbk, xbbk, xtbk, xlo, xstep, xtot, xidx, xvah, xval, rows, segStart, close, true)
        for n in devFresh
            array.push(nodes, n)

// ════════════════════════ INTERAKTIONER ════════════════════════
// En interaktion öppnas när priset kommer IN i zonen utifrån, och stängs först
// när den löst ut — avvisning eller brott. Därför räknas ett besök som ett
// besök även om priset ligger kvar i zonen i flera barer.
bool   sigLong  = false
bool   sigShort = false
string sigTxt   = ""
float  sigStr   = 0.0
float  sigStop  = na
float  sigTgt   = na

if barstate.isconfirmed and array.size(nodes) > 0
    for n in nodes
        if n.active
            bool inZone  = high >= n.bot and low <= n.top
            int  sideNow = close > n.top ? 1 : close < n.bot ? -1 : 0
            // öppna en ny interaktion
            if inZone and not n.inside and n.side != 0
                n.inside   := true
                n.fromSide := n.side
                n.touches  += 1
            if n.inside and n.fromSide != 0
                int  lim     = retestOn ? maxRetest : 1
                bool countOk = n.touches <= lim and (not finalOnly or n.touches == lim)
                bool strOk   = n.kind == 1 ? n.strength >= minStr : true
                bool rejStr  = sideNow == n.fromSide
                bool rejLoo  = sideNow == 0
                bool isRej   = rejStr or (not reqClose and rejLoo and not inZone)
                float wkFrac = rng > 0 ? (n.fromSide == 1 ? dnWk / rng : upWk / rng) : 0.0
                bool wickOk  = not wickFilt or wkFrac >= wickMin
                bool kindRej = n.kind == 1 ? sigPocRej : sigPovRej
                bool kindBrk = n.kind == 1 ? sigPocBrk : sigPovBrk
                float marg   = breachAtr * atr
                bool  brkRaw = sideNow == -n.fromSide and (sideNow == 1 ? close - n.top >= marg : n.bot - close >= marg)
                bool  trOkL  = not emaFilt or close > trend
                bool  trOkS  = not emaFilt or close < trend
                string kindTx = n.kind == 1 ? (n.isPoc ? "POC" : "HVN") : "POV"
                if isRej
                    bool wantL = n.fromSide == 1
                    if wickOk and momOk and sessOk and kindRej and strOk and countOk and (wantL ? trOkL : trOkS) and n.strength > sigStr
                        sigStr   := n.strength
                        sigLong  := wantL
                        sigShort := not wantL
                        sigTxt   := kindTx + " avvisning " + str.tostring(n.strengthPct, "#.##") + "% T" + str.tostring(n.touches)
                        sigStop  := wantL ? n.bot - slAtr * atr : n.top + slAtr * atr
                    n.inside := false
                else if brkRaw
                    bool wantL2 = sideNow == 1
                    if momOk and sessOk and kindBrk and strOk and countOk and (wantL2 ? trOkL : trOkS) and n.strength > sigStr
                        sigStr   := n.strength
                        sigLong  := wantL2
                        sigShort := not wantL2
                        sigTxt   := kindTx + " brott " + str.tostring(n.strengthPct, "#.##") + "% T" + str.tostring(n.touches)
                        sigStop  := wantL2 ? n.bot - slAtr * atr : n.top + slAtr * atr
                    n.inside := false
                    if killBrk
                        n.active := false
                if not n.inside and n.touches >= (retestOn ? maxRetest : 1)
                    n.active := false
                if n.kind == -1 and not extendPov and not n.inside
                    n.active := false
            if sideNow != 0
                n.side := sideNow

if (sigLong or sigShort) and not na(sigStop)
    float risk = math.abs(close - sigStop)
    sigTgt := sigLong ? close + rrMult * risk : close - rrMult * risk

// ════════════════════════ RITNING ════════════════════════
var array<line>  drawLn = array.new_line()
var array<label> drawLb = array.new_label()
var array<box>   drawBx = array.new_box()

if barstate.islast
    while array.size(drawLn) > 0
        line.delete(array.pop(drawLn))
    while array.size(drawLb) > 0
        label.delete(array.pop(drawLb))
    while array.size(drawBx) > 0
        box.delete(array.pop(drawBx))
    if array.size(nodes) > 0
        for n in nodes
            color c  = n.kind == 1 ? (n.isPoc ? colPOC : colHVN) : colPOV
            color cc = n.active ? c : color.new(c, 72)
            if na(n.bx)
                n.bx := box.new(n.bornBar, n.top, bar_index, n.bot, border_color = na, bgcolor = color.new(c, zoneTr))
                n.ln := line.new(n.bornBar, n.price, bar_index, n.price, color = cc, width = n.isPoc ? 2 : 1,
                     style = n.kind == 1 ? line.style_solid : line.style_dashed)
                n.lb := label.new(bar_index, n.price, "", style = label.style_label_left,
                     color = color.new(color.black, 100), textcolor = cc, size = size.tiny)
            box.set_right(n.bx, bar_index)
            box.set_bgcolor(n.bx, color.new(c, n.active ? zoneTr : math.min(96, zoneTr + 14)))
            line.set_x2(n.ln, bar_index)
            line.set_color(n.ln, cc)
            string kindTx = n.kind == 1 ? (n.isPoc ? "POC" : "HVN") : "POV"
            string txt = kindTx + "  " + str.tostring(n.price, format.mintick) + "  " + str.tostring(n.strengthPct, "#.##") + "%"
            txt += n.kind == 1 ? "  " + str.tostring(n.strength, "#.#") + "x" : "  tunn " + str.tostring(100 * n.strength, "#") + "%"
            if profCvd
                txt += "  " + str.tostring(n.buyPct >= 50 ? n.buyPct : 100 - n.buyPct, "#") + "% " + (n.buyPct >= 50 ? "B" : "S")
            if not na(vwapV) and vwapV > 0
                txt += "  VW " + (n.price >= vwapV ? "+" : "") + str.tostring(100 * (n.price - vwapV) / vwapV, "#.##") + "%"
            txt += "  t" + str.tostring(n.timeAt, "#")
            if n.touches > 0
                txt += "  T" + str.tostring(n.touches)
            if not n.active
                txt += "  slut"
            label.set_xy(n.lb, bar_index + 2, n.price)
            label.set_text(n.lb, txt)
            label.set_textcolor(n.lb, cc)
    int nAll2 = array.size(cVol)
    if showProf and nAll2 > 10
        [dlo, dstep, dbk, dbbk, dtbk, dtot, dbuy, dhi] = f_profile(cHi, cLo, cVol, cBuy, nAll2, rows)
        if dtot > 0 and dstep > 0
            [didx, dmax] = f_poc(dbk)
            [dvah, dval] = f_va(dbk, didx, dtot, vaPct)
            int x0 = math.max(0, math.max(segStart, bar_index - barsScan))
            int wMax = math.max(6, int((bar_index - x0) * 0.22))
            if profBack
                array.push(drawBx, box.new(x0, dhi, bar_index, dlo, border_color = na, bgcolor = color.new(#0a1a24, 92)))
            if dmax > 0
                for j = 0 to rows - 1
                    float v = array.get(dbk, j)
                    if v > 0
                        int w = math.max(1, int(math.round(math.sqrt(v / dmax) * wMax)))
                        float y = dlo + (j + 0.5) * dstep
                        color bc = j == didx ? colPOC : (j >= dval and j <= dvah ? color.new(colBars, math.max(0, color.t(colBars) - 22)) : colBars)
                        array.push(drawLn, line.new(x0, y, x0 + w, y, color = bc, width = 1))
            if showVA
                float vahP = dlo + (dvah + 1) * dstep
                float valP = dlo + dval * dstep
                array.push(drawLn, line.new(x0, vahP, bar_index, vahP, color = colVA, style = line.style_dotted))
                array.push(drawLn, line.new(x0, valP, bar_index, valP, color = colVA, style = line.style_dotted))
                array.push(drawLb, label.new(bar_index + 2, vahP, "VAH", style = label.style_label_left, color = color.new(color.black, 100), textcolor = colVA, size = size.tiny))
                array.push(drawLb, label.new(bar_index + 2, valP, "VAL", style = label.style_label_left, color = color.new(color.black, 100), textcolor = colVA, size = size.tiny))

plotshape(sigLong  ? low  - 0.7 * atr : na, "NBE Long",  shape.triangleup,   location.absolute, colUp, size = size.small)
plotshape(sigShort ? high + 0.7 * atr : na, "NBE Short", shape.triangledown, location.absolute, colDn, size = size.small)
plot(emaFilt ? trend : na, "Trend", color = color.new(#7f8ca6, 35))

if showSigLb and (sigLong or sigShort)
    label.new(bar_index, sigLong ? low - 1.4 * atr : high + 1.4 * atr, sigTxt,
         style = sigLong ? label.style_label_up : label.style_label_down,
         color = color.new(color.black, 100), textcolor = sigLong ? colUp : colDn, size = size.tiny)

var array<line> tpLn = array.new_line()
if tradeMode == "Custom" and tradeVis and (sigLong or sigShort) and not na(sigStop) and not na(sigTgt)
    color tc = sigLong ? colUp : colDn
    array.push(tpLn, line.new(bar_index, close,   bar_index + 14, close,   color = tc, width = 1))
    array.push(tpLn, line.new(bar_index, sigStop, bar_index + 14, sigStop, color = color.new(#f23645, 25), style = line.style_dashed))
    array.push(tpLn, line.new(bar_index, sigTgt,  bar_index + 14, sigTgt,  color = color.new(#00e676, 25), style = line.style_dashed))
    while array.size(tpLn) > tradeHist * 3
        line.delete(array.shift(tpLn))

// ════════════════════════ DASHBOARD ════════════════════════
float cumV   = ta.cum(nz(volume))
float volAvg = ta.sma(nz(volume), 50)
var table dash = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 22), border_width = 1, border_color = color.new(color.gray, 72))
if barstate.islast and showDash
    color mut = color.new(color.gray, 20)
    int nAct = 0
    if array.size(nodes) > 0
        for n in nodes
            if n.active
                nAct += 1
    table.cell(dash, 0, 0, "PROFIL", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, profType + " · " + profWin, text_color = color.new(#00e5ff, 0), text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 1, "POC", text_color = colPOC, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, na(lastPoc) ? "–" : str.tostring(lastPoc, format.mintick), text_color = na(lastPoc) ? mut : close >= lastPoc ? colUp : colDn, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 2, "POV", text_color = colPOV, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, na(lastPov) ? "–" : str.tostring(lastPov, format.mintick), text_color = na(lastPov) ? mut : close >= lastPov ? colUp : colDn, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 3, "VA", text_color = colVA, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, na(lastVah) ? "–" : str.tostring(lastVal, format.mintick) + " – " + str.tostring(lastVah, format.mintick), text_color = colVA, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 4, "PROFIL-CVD", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4, not profCvd or na(lastBuyP) ? "–" : str.tostring(lastBuyP, "#") + "% B · POC " + str.tostring(lastPocB, "#") + "%", text_color = na(lastBuyP) ? mut : lastBuyP >= 50 ? colUp : colDn, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 5, "SWING", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5, not swingChg or na(lastChg) ? "–" : (lastChg >= 0 ? "+" : "") + str.tostring(lastChg, "#.##") + "%", text_color = na(lastChg) ? mut : lastChg >= 0 ? colUp : colDn, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 6, "STYRKA", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 6, na(lastNS) ? "–" : str.tostring(lastNS, "#.##") + "% (POC/Total)", text_color = na(lastNS) ? mut : colPOC, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 7, "NODER", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 7, str.tostring(nAct) + " aktiva / " + str.tostring(array.size(nodes)), text_color = nAct > 0 ? color.new(#00e5ff, 0) : mut, text_size = size.small, text_halign = text.align_right)

var table wm = table.new(position.bottom_right, 1, 1)
if barstate.islast
    bool noVol   = cumV == 0
    bool tickVol = not noVol and volAvg < 1000 and syminfo.type == "cfd"
    string wtxt = noVol ? "GRABIT NBE — INGEN VOLYMDATA, profilen är meningslös" : tickVol ? "GRABIT NBE — ser ut som tickvolym, inte kontrakt" : "GRABIT NBE"
    table.cell(wm, 0, 0, wtxt, text_color = noVol ? color.new(#f23645, 0) : tickVol ? color.new(#ffc400, 20) : color.new(color.gray, 60), text_size = size.small)

// ════════════════════════ LARM ════════════════════════
alertcondition(sigLong,  "NBE Long",  "GRABIT NBE: long vid nod")
alertcondition(sigShort, "NBE Short", "GRABIT NBE: short vid nod")
alertcondition(sigLong or sigShort, "NBE Signal", "GRABIT NBE: nodsignal")

if sigLong or sigShort
    string jm = '{"ticker":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix +
         '","action":"' + (sigLong ? "buy" : "sell") +
         '","price":' + str.tostring(close) +
         (na(sigStop) ? "" : ',"stop":' + str.tostring(sigStop)) +
         (na(sigTgt)  ? "" : ',"target":' + str.tostring(sigTgt)) +
         ',"interval":"' + timeframe.period +
         '","strategy":"NBE","note":"' + sigTxt + '"}'
    alert(jm, alert.freq_once_per_bar_close)
