// GRABIT Breakout · strategy
// ---------------------------------------------------------------------------
// Testar samma sorts signal som säljs som "Weakness Below X / Strength Above X":
// bryt en nivå, stop på andra sidan, tre mål med avskalning.
//
// Poängen är inte signalen — den är trivial — utan att få fram de siffror som
// faktiskt avgör om den tjänar pengar. Vinstprocent på T1 säger nästan
// ingenting när T1 ligger närmare än stoppen. Med stop 36 punkter och T1 16
// punkter krävs 69 % träff bara för att gå plus minus noll, före courtage.
// Strategy Tester ger nettoresultat, profit factor och drawdown. Tabellen i
// hörnet visar dessutom hur ofta T1, T2 och T3 nås, så du kan jämföra äpplen
// med äpplen mot en såld statistik.
//
// VIKTIGT innan du tror på ett resultat:
//  · Sätt Properties -> Commission och Slippage. NQ: ca 4-5 USD per round turn
//    och minst 1 tick slippage. Utan det ljuger varje backtest.
//  · Kör Deep Backtest över minst ett par hundra affärer.
//  · Jämför med Bar Replay: signalen ska stå kvar när baren stängt.
//
// Filtren för GEX och delta är avstängda i förval. Mät grundsignalen först,
// slå sen på ett filter i taget och se om något faktiskt förbättras.
// ---------------------------------------------------------------------------
//@version=6
strategy("GRABIT Breakout · strategy", overlay = true, initial_capital = 25000,
     default_qty_type = strategy.fixed, default_qty_value = 3,
     commission_type = strategy.commission.cash_per_order, commission_value = 1.5,
     slippage = 1, calc_on_every_tick = false, process_orders_on_close = true,
     max_labels_count = 300)

// ── Signal ─────────────────────────────────────────────────────────────────
const string G_SIG = "Signal"
string sigMode = input.string("Pivot", "Nivå", options = ["Pivot", "N-bars högsta/lägsta"], group = G_SIG,
     tooltip = "Pivot: bryt av senaste bekräftade swinghög/låg. N-bars: bryt av högsta/lägsta de senaste N barerna — enklare och kan aldrig rita om sig.")
int pvL = input.int(8, "Pivot vänster", minval = 2, maxval = 50, group = G_SIG, inline = "p")
int pvR = input.int(3, "höger", minval = 1, maxval = 20, group = G_SIG, inline = "p",
     tooltip = "En pivot bekräftas först efter så här många barer. Högre = färre och senare signaler.")
int lookback = input.int(20, "N barer", minval = 3, maxval = 200, group = G_SIG)
bool doLong  = input.bool(true, "Long", group = G_SIG, inline = "d")
bool doShort = input.bool(true, "Short", group = G_SIG, inline = "d")

// ── Stop och mål ───────────────────────────────────────────────────────────
const string G_RISK = "Stop och mål"
string stopMode = input.string("ATR", "Stop", options = ["ATR", "Punkter", "Motsatt struktur"], group = G_RISK)
float atrMult = input.float(1.5, "ATR ×", minval = 0.2, step = 0.1, group = G_RISK, inline = "s")
int   atrLen  = input.int(14, "ATR-längd", minval = 2, group = G_RISK, inline = "s")
float stopPts = input.float(36.0, "Stop i punkter", minval = 0.25, step = 0.25, group = G_RISK)
float t1R = input.float(0.5, "T1 (× risk)", minval = 0.1, step = 0.1, group = G_RISK, inline = "t")
float t2R = input.float(1.0, "T2", minval = 0.1, step = 0.1, group = G_RISK, inline = "t")
float t3R = input.float(1.5, "T3", minval = 0.1, step = 0.1, group = G_RISK, inline = "t")
bool  beAfterT1 = input.bool(true, "Flytta stop till break even efter T1", group = G_RISK)

// ── Filter ─────────────────────────────────────────────────────────────────
const string G_FIL = "Filter"
bool useSession = input.bool(true, "Bara inom tid", group = G_FIL, inline = "se")
string sessTime = input.session("0930-1545", "", group = G_FIL, inline = "se",
     tooltip = "Börsens tid (ET på futures). 0930-1545 = USA-sessionen utan de sista minuterna.")
bool useTrend = input.bool(false, "Bara med EMA-trenden", group = G_FIL, inline = "tr")
int  trendLen = input.int(50, "", minval = 5, group = G_FIL, inline = "tr")

bool useGex = input.bool(false, "GEX-filter", group = G_FIL,
     tooltip = "Kräver att levels-strängen klistras in nedan. Long bara över Gamma Flip, short bara under, och signaler som startar för nära motsatt vägg hoppas över.")
string gexSrc = input.string("", "GEX levels string", group = G_FIL)
float wallBuf = input.float(20.0, "Minsta avstånd till motsatt vägg (punkter)", minval = 0, step = 1, group = G_FIL)

bool useDelta = input.bool(false, "Delta-filter", group = G_FIL,
     tooltip = "Kräver att barens volymdelta pekar åt signalens håll. Använder minutintrabarer — sekundupplösning kräver TradingView Premium.")

// ── Nivå att bryta ─────────────────────────────────────────────────────────
var float lvlUp = na
var float lvlDn = na

if sigMode == "Pivot"
    float ph = ta.pivothigh(high, pvL, pvR)
    float pl = ta.pivotlow(low, pvL, pvR)
    lvlUp := na(ph) ? lvlUp : ph
    lvlDn := na(pl) ? lvlDn : pl
else
    lvlUp := ta.highest(high, lookback)[1]
    lvlDn := ta.lowest(low, lookback)[1]

plot(lvlUp, "Nivå upp", color = color.new(#26A69A, 45), style = plot.style_stepline)
plot(lvlDn, "Nivå ner", color = color.new(#EF5350, 45), style = plot.style_stepline)

// ── Filtervärden ───────────────────────────────────────────────────────────
bool inSess = not useSession or not na(time(timeframe.period, sessTime))
float ema = ta.ema(close, trendLen)
bool trendOkL = not useTrend or (close > ema and ema > ema[1])
bool trendOkS = not useTrend or (close < ema and ema < ema[1])

// GEX-strängen: vi behöver bara flip, call wall och put wall.
f_gex(string src, string kind) =>
    float out = na
    if str.length(src) > 0
        array<string> rows = str.split(src, ";")
        for r in rows
            array<string> f = str.split(r, ",")
            if array.size(f) == 3 and str.trim(array.get(f, 2)) == kind and na(out)
                out := str.tonumber(str.trim(array.get(f, 0)))
    out

float gFlip = useGex ? f_gex(gexSrc, "flip") : na
float gCall = useGex ? f_gex(gexSrc, "res") : na
float gPut  = useGex ? f_gex(gexSrc, "sup") : na

bool gexOkL = not useGex or ((na(gFlip) or close > gFlip) and (na(gCall) or gCall - close > wallBuf))
bool gexOkS = not useGex or ((na(gFlip) or close < gFlip) and (na(gPut) or close - gPut > wallBuf))

// Delta ur minutintrabarer — samma metod som GRABIT Delta · CVD.
int    chartSec = timeframe.in_seconds(timeframe.period)
string dLTF = chartSec <= 3600 ? "1" : chartSec <= 14400 ? "5" : "15"
[dO, dC, dV] = request.security_lower_tf(syminfo.tickerid, dLTF, [open, close, volume])
float barDelta = 0.0
if not na(dC) and array.size(dC) > 0
    for i = 0 to array.size(dC) - 1
        float o = array.get(dO, i)
        float c = array.get(dC, i)
        float v = nz(array.get(dV, i))
        barDelta += c > o ? v : c < o ? -v : 0.0
else
    barDelta := close > open ? nz(volume) : close < open ? -nz(volume) : 0.0

bool deltaOkL = not useDelta or barDelta > 0
bool deltaOkS = not useDelta or barDelta < 0

// ── Signal ─────────────────────────────────────────────────────────────────
bool flat = strategy.position_size == 0
bool longSig  = doLong  and flat and inSess and trendOkL and gexOkL and deltaOkL and not na(lvlUp) and ta.crossover(close, lvlUp)
bool shortSig = doShort and flat and inSess and trendOkS and gexOkS and deltaOkS and not na(lvlDn) and ta.crossunder(close, lvlDn)

float atr = ta.atr(atrLen)
f_risk(bool isLong) =>
    float r = switch stopMode
        "ATR"      => atr * atrMult
        "Punkter"  => stopPts
        => isLong ? math.max(close - nz(lvlDn, close - atr), atr * 0.5) : math.max(nz(lvlUp, close + atr) - close, atr * 0.5)
    math.max(r, syminfo.mintick * 4)

var float entryPx = na
var float riskPts = na
var bool  beHit = false

if longSig
    riskPts := f_risk(true)
    entryPx := close
    beHit := false
    strategy.entry("L", strategy.long)
if shortSig
    riskPts := f_risk(false)
    entryPx := close
    beHit := false
    strategy.entry("S", strategy.short)

// ── Utgångar ───────────────────────────────────────────────────────────────
float avg = strategy.position_avg_price
bool  isLong = strategy.position_size > 0
bool  isShort = strategy.position_size < 0

float t1 = isLong ? avg + riskPts * t1R : avg - riskPts * t1R
float t2 = isLong ? avg + riskPts * t2R : avg - riskPts * t2R
float t3 = isLong ? avg + riskPts * t3R : avg - riskPts * t3R
float slBase = isLong ? avg - riskPts : avg + riskPts

if isLong and not beHit and high >= t1
    beHit := true
if isShort and not beHit and low <= t1
    beHit := true

float slNow = beAfterT1 and beHit ? avg : slBase

if isLong
    strategy.exit("T1", "L", qty = 1, limit = t1, stop = slNow)
    strategy.exit("T2", "L", qty = 1, limit = t2, stop = slNow)
    strategy.exit("T3", "L", limit = t3, stop = slNow)
if isShort
    strategy.exit("T1", "S", qty = 1, limit = t1, stop = slNow)
    strategy.exit("T2", "S", qty = 1, limit = t2, stop = slNow)
    strategy.exit("T3", "S", limit = t3, stop = slNow)

// ── Räkna hur ofta varje mål nås ───────────────────────────────────────────
var int nTrades = 0
var int nT1 = 0
var int nT2 = 0
var int nT3 = 0
var int nStop = 0
var bool hit1 = false
var bool hit2 = false
var bool hit3 = false

if longSig or shortSig
    nTrades += 1
    hit1 := false
    hit2 := false
    hit3 := false

if isLong or isShort
    bool h1 = isLong ? high >= t1 : low <= t1
    bool h2 = isLong ? high >= t2 : low <= t2
    bool h3 = isLong ? high >= t3 : low <= t3
    if h1 and not hit1
        hit1 := true
        nT1 += 1
    if h2 and not hit2
        hit2 := true
        nT2 += 1
    if h3 and not hit3
        hit3 := true
        nT3 += 1

// Stoppad utan att T1 nåtts = ren förlust.
if strategy.position_size == 0 and strategy.position_size[1] != 0 and not hit1
    nStop += 1

// ── Tabell ─────────────────────────────────────────────────────────────────
f_pct(int a, int b) =>
    b > 0 ? str.tostring(100.0 * a / b, "#.#") + " %" : "–"

var table tb = table.new(position.bottom_right, 2, 7, bgcolor = color.new(#131316, 10),
     border_width = 1, border_color = color.new(#2A2A31, 40))
if barstate.islast
    float br = t1R > 0 ? 100.0 / (1.0 + t1R) : na
    table.cell(tb, 0, 0, "GRABIT Breakout", text_color = #F0B90B, text_size = size.small, text_formatting = text.format_bold)
    table.cell(tb, 1, 0, str.tostring(nTrades) + " affärer", text_color = #E8E6E1, text_size = size.small)
    table.cell(tb, 0, 1, "T1 nådd", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 1, f_pct(nT1, nTrades), text_color = #26A69A, text_size = size.small, text_formatting = text.format_bold)
    table.cell(tb, 0, 2, "T2 nådd", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 2, f_pct(nT2, nTrades), text_color = #26A69A, text_size = size.small)
    table.cell(tb, 0, 3, "T3 nådd", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 3, f_pct(nT3, nTrades), text_color = #26A69A, text_size = size.small)
    table.cell(tb, 0, 4, "Stop utan T1", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 4, f_pct(nStop, nTrades), text_color = #EF5350, text_size = size.small)
    table.cell(tb, 0, 5, "Krävs för nollresultat", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 5, na(br) ? "–" : str.tostring(br, "#.#") + " %", text_color = #F0B90B,
         text_size = size.small, text_formatting = text.format_bold)
    table.cell(tb, 0, 6, "Netto (se Strategy Tester)", text_color = #7A7A85, text_size = size.tiny)
    table.cell(tb, 1, 6, str.tostring(strategy.netprofit, "#") + " USD",
         text_color = strategy.netprofit >= 0 ? #26A69A : #EF5350, text_size = size.tiny)
