//@version=6
// GRABIT — vwap - volume profile with IB / sessions
// Klistra in i TradingView Pine Editor -> Save -> Add to chart.
//
// Ändringslogg (senaste):
//  · NY: Profiltyp "Delta + Volym" (förval), ritad som tunna linjer per rad. Vänster om mittlinjen
//    är deltat per nivå (cyan = köpare ledde, rött = säljare). Höger är total volym, cyan köpdel
//    närmast mitten och röd säljdel utanför. Delta och volym står som ren text utan ruta.
//  · NY: Högerprofilen är delad köp/sälj — säljare åt vänster (röd), köpare åt höger (grön)
//    runt en mittlinje. Delta i % överst och total volym (köp/sälj) underst. Valfria siffror
//    per prisnivå. "Klassisk" finns kvar som profiltyp.
//    Köp/sälj skattas ur 1-minutersbarer (var i baren den stängde) — inte riktig bid/ask.
//  · FIX: Dashboardens DELTA räknas nu som (köp − sälj) / total, samma som profilen.
//  · FIX: Högerprofilens rader ritas med bar-index i stället för tid. Tidsbaserad x hamnade
//    i helg-/sessionsluckor (fredag kväll, helg) och kollapsade till noll bredd → profilen "borta".
//  · RENSNING: nya defaults — Asia/London av, öppningslabels av, IB-extensioner av, HTF-swingar av,
//    order blocks av, POC-zoner max 3 utan text, developing POC-spår av, dashboard 4 rader.
//    Allt finns kvar som val i inställningarna.
//  · FIX: Last week POC räknas nu ur de stängda sessionsprofilerna.
//  · POC-zoner per session, developing POC-spår, heatmap, Buy/Sell/Delta, ritstil Streck,
//    skalning av bredd, pågående session i högerprofilen, VA enligt TV-metoden, HTF swing, SMC-OB.
indicator("vwap - volume profile with IB / sessions - by Grabit", "Grabit VP", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_polylines_count=100, max_bars_back=2000)

// ════════════════════ INPUTS ════════════════════
// Instrument
gX = "Instrument"
presetSel = input.string("Auto", "Preset", options=["Auto", "MNQ/NQ", "GULD (GC/MGC)", "Av"], group=gX, tooltip="Auto känner igen NQ/MNQ och GC/MGC/XAU på tickern. GULD flyttar NY-sessionen till COMEX-pitfönstret (14:20–19:30 svensk tid).")

// VWAP
gV = "VWAP"
showVwap  = input.bool(true, "Visa VWAP", group=gV)
showB1    = input.bool(true, "Band ±1 SD", group=gV)
showB2    = input.bool(false, "Band ±2 SD", group=gV)
fillBand  = input.bool(false, "Fyllnad mellan band", group=gV)
colVwap   = input.color(color.new(#00e5ff, 0), "VWAP-färg", group=gV)
colBand   = input.color(color.new(#00e5ff, 92), "Bandfyllnad", group=gV)

// Volume Profile
gP = "Volume Profile"
profMode  = input.string("Höger sida", "Läge", options=["Höger sida", "I sessionerna"], group=gP)
profType  = input.string("Delta + Volym", "Profiltyp (högerläge)", options=["Delta + Volym", "Köp/Sälj (delad)", "Klassisk"], group=gP, tooltip="Delta + Volym: till vänster om mittlinjen deltat per nivå (grönt = fler köpare, rött = fler säljare), till höger total volym där den gröna delen är köp och den röda sälj.\nKöp/Sälj (delad): säljare åt vänster, köpare åt höger.")
deltaShare= input.int(35, "Deltasidans andel av bredden (%)", minval=15, maxval=60, group=gP)
showDT    = input.bool(true, "Delta och Total vid profilen", group=gP)
numGroups = input.int(0, "Siffror per nivå (antal grupper, 0 = av)", minval=0, maxval=40, group=gP, tooltip="Slår ihop raderna till så här många nivåer och skriver köp/sälj-volym vid varje, som en footprint. 15–25 brukar vara läsbart.")
colBuyP   = input.color(color.new(#00e5ff, 10), "Köpare", group=gP)
colSellP  = input.color(color.new(#ff1744, 10), "Säljare", group=gP)
res       = input.timeframe("D",  "Profilperiod (session)", group=gP)
rows      = input.int(400, "Rader per profil", minval=20, maxval=400, group=gP)
vaPct     = input.float(70, "Value Area %", minval=50, maxval=95, group=gP) / 100
profSrc   = input.string("Pågående session", "Data i högerprofil", options=["Pågående session", "Lookback (bars)"], group=gP)
lookback  = input.int(240, "Bars i högerprofil (lookback-läge)", minval=50, maxval=1000, group=gP)
drawStyle = input.string("Streck (TV-look)", "Ritstil", options=["Streck (TV-look)", "Boxar"], group=gP)
rowGap    = input.int(25, "Mellanrum mellan rader (%, boxläge)", minval=0, maxval=60, group=gP)
profScale = input.string("Kvadratrot", "Skalning av bredd", options=["Linjär", "Kvadratrot", "Klipp topp 90%"], group=gP)
offBars   = input.int(25,  "Avstånd från priset (bars)", minval=2, maxval=100, group=gP)
profWbars = input.int(80,  "Profilbredd (bars, högerläge)", minval=10, maxval=200, group=gP)
widthPct  = input.float(18, "Profilbredd % (sessionsläge)", minval=5, maxval=60, group=gP) / 100
showProf  = input.bool(true,  "Visa profil", group=gP)
smoothN   = input.int(0, "Utjämning (rader, 0 = av)", minval=0, maxval=10, group=gP)
showVA    = input.bool(true,  "VAH/VAL-linjer", group=gP)
showDash  = input.bool(true,  "Dashboard", group=gP)
colProf   = input.color(color.new(#4b5568, 45), "Bars", group=gP)
colVAbar  = input.color(color.new(#7f8ca6, 32), "Bars i Value Area", group=gP)
colPOCbar = input.color(color.new(#ffc400, 12), "POC-bar", group=gP)
colVA     = input.color(color.new(#00e5ff, 55), "VAH/VAL-linjer", group=gP)
colPOC    = input.color(color.new(#ffc400, 0), "POC-linje", group=gP)

// Sessioner
gS = "Sessioner (svensk tid som standard)"
tzS       = input.string("Europe/Stockholm", "Tidszon", options=["Europe/Stockholm", "Europe/London", "America/New_York", "UTC"], group=gS)
showAsia  = input.bool(false, "Asien", inline="a", group=gS)
asiaSess  = input.session("0100-0900", "", inline="a", group=gS)
colAsia   = input.color(color.new(#9d6bff, 0), "", inline="a", group=gS)
showLdn   = input.bool(false, "London", inline="l", group=gS)
ldnSess   = input.session("0900-1730", "", inline="l", group=gS)
colLdn    = input.color(color.new(#2979ff, 0), "", inline="l", group=gS)
showNy    = input.bool(true, "New York", inline="n", group=gS)
nySess    = input.session("1530-2200", "", inline="n", group=gS)
colNy     = input.color(color.new(#00e5ff, 0), "", inline="n", group=gS)
sessLines = input.bool(false, "Sessionslinjer (av = endast text)", group=gS)
sessTransp= input.int(35, "Tona ner linjer", minval=0, maxval=90, group=gS)
openLbls  = input.bool(false, "Label vid varje öppning", group=gS)

// Initial Balance
gI = "Initial Balance"
showIB    = input.bool(true, "Visa IB", group=gI)
ibAnchor  = input.string("New York", "IB räknas från öppning", options=["New York", "London", "Asien"], group=gI)
ibMin     = input.int(60, "IB-längd (minuter)", minval=15, maxval=240, group=gI)
ibExt     = input.int(8, "Stubb-längd (bars ut från priset)", minval=3, maxval=30, group=gI)
showIBx   = input.bool(false, "Extensioner (Mid, x2)", group=gI)
ibLabels  = input.bool(true, "IB-breakout (endast alerts)", group=gI)
colIB     = input.color(color.new(#ffffff, 55), "IB-färg", group=gI)

// PDH / PDL
gD2 = "PDH / PDL (gårdagens high/low)"
showPD    = input.bool(true, "Visa PDH/PDL", group=gD2)
showPrevVA= input.bool(true, "dVAH/dVAL (gårdagens value area)", group=gD2)
colPD     = input.color(color.new(#e0e0e0, 30), "Färg", group=gD2)
var float lastVahP = na
var float lastValP = na

// POC-nivåer
gY = "POC-nivåer (Yesterday / Last week)"
showStubs   = input.bool(true, "Stubbar vid priset", group=gY)
showWeekDev = input.bool(false, "Visa även pågående veckas POC", group=gY)
colYpoc     = input.color(color.new(#ffc400, 0), "Yesterday POC", group=gY)
colWpoc     = input.color(color.new(#ff9100, 0), "Last week POC", group=gY)

// POC-zoner per session
gZ = "POC-zoner per session"
zoneOn   = input.bool(true, "POC-zoner (förlängda)", group=gZ)
zoneMax  = input.int(3, "Max sessioner", minval=1, maxval=30, group=gZ)
zoneRowsN= input.int(6, "Zonhöjd (rader av profilen)", minval=1, maxval=40, group=gZ)
zoneExt  = input.bool(true, "Förläng till aktuell bar", group=gZ)
zoneLbl  = input.bool(false, "Etikett (volym + köp/sälj)", group=gZ)
zoneMid  = input.bool(true, "Streckad mittlinje", group=gZ)
zoneKill = input.bool(false, "Ta bort när priset stängt igenom", group=gZ)
zoneTr   = input.int(70, "Transparens", minval=0, maxval=100, group=gZ)
colZup   = input.color(color.new(#00e5ff, 0), "Zon under priset", group=gZ)
colZdn   = input.color(color.new(#f23645, 0), "Zon över priset", group=gZ)
devOn    = input.bool(false, "Developing POC-spår (pågående session)", group=gZ)
devRows  = input.int(50, "Rader för spår/heatmap", minval=10, maxval=100, group=gZ)
heatOn   = input.bool(false, "Heatmap i sessionerna", group=gZ)
heatMax  = input.int(5, "Heatmap: sessioner", minval=1, maxval=8, group=gZ)
heatTr   = input.int(75, "Heatmap: transparens", minval=0, maxval=100, group=gZ)

// Trendmoln
gC = "Trendmoln"
showCloud = input.bool(false, "Visa moln", group=gC)
fLen      = input.int(50,  "EMA snabb", group=gC)
sLen      = input.int(100, "EMA långsam", group=gC)
colBull   = input.color(color.new(#00e5ff, 92), "Moln upp", group=gC)
colBear   = input.color(color.new(#ff2e88, 92), "Moln ned", group=gC)

// Candles
gB = "Candles"
paintBars = input.bool(true, "Färga candles i temat", group=gB)
colCup    = input.color(color.new(#00e5ff, 0), "Upp", group=gB)
colCdn    = input.color(color.new(#f23645, 0), "Ned", group=gB)

// Extremkanal
gK = "Extremkanal"
showCh    = input.bool(false, "Visa kanal", group=gK)
chLen     = input.int(240, "Lookback (bars)", minval=20, maxval=1000, group=gK)
fillCh    = input.bool(false, "Fyllnad", group=gK)
colCh     = input.color(color.new(#2aa8b8, 62), "Kanalfärg", group=gK)
colChFill = input.color(color.new(#2aa8b8, 96), "Fyllnadsfärg", group=gK)

// HTF swing-nivåer
gSw = "HTF swing high/low"
swOn      = input.bool(false, "Visa HTF swing-nivåer", group=gSw)
swTf1     = input.timeframe("60", "Timeframe 1", group=gSw)
swTf2     = input.timeframe("240", "Timeframe 2", group=gSw)
swLen     = input.int(5, "Pivot-längd (bars på HTF)", minval=2, maxval=20, group=gSw)
swHighs   = input.bool(true, "Swing highs", group=gSw)
swLows    = input.bool(true, "Swing lows", group=gSw)
colSw1    = input.color(color.new(#ff5252, 0), "Färg TF1", group=gSw)
colSw2    = input.color(color.new(#ff1744, 0), "Färg TF2", group=gSw)

// Order Blocks (SMC / BOS)
gO = "Order Blocks"
obOn    = input.bool(false, "Visa order blocks", group=gO)
obPiv   = input.int(5, "Pivot-längd (struktur)", minval=2, maxval=20, group=gO)
obConf  = input.string("Close", "BOS-bekräftelse", options=["Close", "Wick"], group=gO)
obZone  = input.string("Body", "Zon", options=["Body", "Hela range"], group=gO)
obLook  = input.int(15, "Max bars bak till OB-candlen", minval=3, maxval=50, group=gO)
obMult  = input.float(1.0, "Displacement-krav (×ATR, 0 = av)", minval=0, step=0.1, group=gO)
obBosLbl= input.bool(true, "Visa BOS-markering", group=gO)
obMaxN  = input.int(6, "Max aktiva blocks", minval=2, maxval=20, group=gO)
obTransp= input.int(40, "Tona ner", minval=0, maxval=90, group=gO)
obTxt   = input.bool(true, "Visa text i blocken", group=gO)
colObUp = input.color(color.new(#00e5ff, 84), "Bull OB", group=gO)
colObDn = input.color(color.new(#ff2e88, 84), "Bear OB", group=gO)

newSess = timeframe.change(res)
newWeek = timeframe.change("W")

// Instrument-preset
bool isGoldSym = syminfo.root == "GC" or syminfo.root == "MGC" or str.contains(syminfo.ticker, "XAU")
bool useGold   = presetSel == "GULD (GC/MGC)" or (presetSel == "Auto" and isGoldSym)
string nySessEff = useGold ? "1420-1930" : nySess

// Nedtonade sessionsfärger
cAsia = color.new(colAsia, math.min(95, color.t(colAsia) + sessTransp))
cLdn  = color.new(colLdn,  math.min(95, color.t(colLdn)  + sessTransp))
cNy   = color.new(colNy,   math.min(95, color.t(colNy)   + sessTransp))

// Buy/sell-split per bar + ATR
float bRng  = high - low
float buyVb = bRng > 0 ? volume * (close - low) / bRng : volume * 0.5
float atrF  = ta.atr(14)
float cumVolAll = ta.cum(nz(volume))

// Intrabar-data
int tfSec = timeframe.in_seconds()
string ltfRes = tfSec >= 3600 ? "5" : tfSec > 60 ? "1" : timeframe.period
[ltfH, ltfL, ltfV, ltfC] = request.security_lower_tf(syminfo.tickerid, ltfRes, [high, low, volume, close])

// ════════════════════ VWAP ════════════════════
var float cumPV  = 0.0
var float cumV   = 0.0
var float cumPV2 = 0.0
if newSess
    cumPV  := 0.0
    cumV   := 0.0
    cumPV2 := 0.0
src = hlc3
cumPV  += src * volume
cumV   += volume
cumPV2 += src * src * volume
vwap = cumV > 0 ? cumPV / cumV : na
sd   = cumV > 0 ? math.sqrt(math.max(cumPV2 / cumV - vwap * vwap, 0)) : na

plot(showVwap ? vwap : na, "VWAP", color=colVwap, linewidth=3)
u1 = plot(showVwap and showB1 ? vwap + sd : na, "+1 SD", color=color.new(colVwap, 55))
l1 = plot(showVwap and showB1 ? vwap - sd : na, "-1 SD", color=color.new(colVwap, 55))
u2 = plot(showVwap and showB2 ? vwap + 2 * sd : na, "+2 SD", color=color.new(colVwap, 40))
l2 = plot(showVwap and showB2 ? vwap - 2 * sd : na, "-2 SD", color=color.new(colVwap, 40))
fill(u1, l1, color=showVwap and showB1 and fillBand ? colBand : na)
fill(u2, l2, color=showVwap and showB2 and fillBand and not showB1 ? colBand : na)

// ════════════════════ SESSIONER ════════════════════
sessTrack(string sessStr) =>
    bool inS = timeframe.isintraday and not na(time(timeframe.period, sessStr, tzS))
    bool newS = inS and not inS[1]
    var float h = na
    var float l = na
    var int hB = na
    var int lB = na
    if newS
        h := high
        l := low
        hB := bar_index
        lB := bar_index
    else if inS
        if high > h
            h := high
            hB := bar_index
        if low < l
            l := low
            lB := bar_index
    [inS, newS, h, l, hB, lB]

[aIn, aNew, aHi, aLo, aHiB, aLoB] = sessTrack(asiaSess)
[lIn, lNew, lHi, lLo, lHiB, lLoB] = sessTrack(ldnSess)
[nIn, nNew, nHi, nLo, nHiB, nLoB] = sessTrack(nySessEff)

plot(showAsia and sessLines and not aNew ? aHi : na, "Asia High", color=cAsia, style=plot.style_linebr)
plot(showAsia and sessLines and not aNew ? aLo : na, "Asia Low",  color=cAsia, style=plot.style_linebr)
plot(showLdn  and sessLines and not lNew ? lHi : na, "London High", color=cLdn, style=plot.style_linebr)
plot(showLdn  and sessLines and not lNew ? lLo : na, "London Low",  color=cLdn, style=plot.style_linebr)
plot(showNy   and sessLines and not nNew ? nHi : na, "NY High", color=cNy, style=plot.style_linebr)
plot(showNy   and sessLines and not nNew ? nLo : na, "NY Low",  color=cNy, style=plot.style_linebr)

var array<label> sessLbls = array.new_label()
if barstate.islast
    while array.size(sessLbls) > 0
        label.delete(array.pop(sessLbls))
    if showAsia and not na(aHi)
        array.push(sessLbls, label.new(aHiB, aHi, "Asia High", style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.new(colAsia, 0), size=size.small))
        array.push(sessLbls, label.new(aLoB, aLo, "Asia Low", style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.new(colAsia, 0), size=size.small))
    if showLdn and not na(lHi)
        array.push(sessLbls, label.new(lHiB, lHi, "London High", style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.new(colLdn, 0), size=size.small))
        array.push(sessLbls, label.new(lLoB, lLo, "London Low", style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.new(colLdn, 0), size=size.small))
    if showNy and not na(nHi)
        array.push(sessLbls, label.new(nHiB, nHi, "NY High", style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.new(colNy, 0), size=size.small))
        array.push(sessLbls, label.new(nLoB, nLo, "NY Low", style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.new(colNy, 0), size=size.small))

if openLbls and showAsia and aNew
    label.new(bar_index, high, "ASIA", style=label.style_label_down, color=color.new(color.black, 100), textcolor=cAsia, size=size.tiny)
if openLbls and showLdn and lNew
    label.new(bar_index, high, "LDN", style=label.style_label_down, color=color.new(color.black, 100), textcolor=cLdn, size=size.tiny)
if openLbls and showNy and nNew
    label.new(bar_index, high, "NY", style=label.style_label_down, color=color.new(color.black, 100), textcolor=cNy, size=size.tiny)

// ════════════════════ INITIAL BALANCE ════════════════════
anchorNew = ibAnchor == "New York" ? nNew : ibAnchor == "London" ? lNew : aNew
anchorIn  = ibAnchor == "New York" ? nIn  : ibAnchor == "London" ? lIn  : aIn

var float ibHi = na
var float ibLo = na
var bool  ibDone = false
var bool  ibUp   = false
var bool  ibDn   = false
var int   ibT0 = na

if anchorNew
    ibT0   := time
    ibHi   := high
    ibLo   := low
    ibDone := false
    ibUp   := false
    ibDn   := false

inIB = not na(ibT0) and (time - ibT0) < ibMin * 60 * 1000 and anchorIn
if inIB
    ibHi := math.max(ibHi, high)
    ibLo := math.min(ibLo, low)
else if not na(ibT0) and (time - ibT0) >= ibMin * 60 * 1000
    ibDone := true

var array<line>  ibLns = array.new_line()
var array<label> ibLbs = array.new_label()
if barstate.islast
    while array.size(ibLns) > 0
        line.delete(array.pop(ibLns))
    while array.size(ibLbs) > 0
        label.delete(array.pop(ibLbs))
    if showIB and ibDone and anchorIn
        int ibX1 = bar_index + 3
        int ibX2 = bar_index + math.max(8, offBars - 2)
        array.push(ibLns, line.new(ibX1, ibHi, ibX2, ibHi, color=colIB, width=1))
        array.push(ibLns, line.new(ibX1, ibLo, ibX2, ibLo, color=colIB, width=1))
        array.push(ibLbs, label.new(ibX1, ibHi, "IB High  " + str.tostring(ibHi, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colIB, 0), size=size.small))
        array.push(ibLbs, label.new(ibX1, ibLo, "IB Low  " + str.tostring(ibLo, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colIB, 0), size=size.small))
        if showIBx
            float ibR = ibHi - ibLo
            float ibM = (ibHi + ibLo) / 2
            float ibH1 = ibHi + ibR / 2
            float ibL1 = ibLo - ibR / 2
            float ibH2 = ibHi + ibR
            float ibL2 = ibLo - ibR
            array.push(ibLns, line.new(ibX1, ibM, ibX2, ibM, color=colIB, style=line.style_dotted))
            array.push(ibLns, line.new(ibX1, ibH1, ibX2, ibH1, color=colIB, style=line.style_dotted))
            array.push(ibLns, line.new(ibX1, ibL1, ibX2, ibL1, color=colIB, style=line.style_dotted))
            array.push(ibLns, line.new(ibX1, ibH2, ibX2, ibH2, color=colIB, style=line.style_dotted))
            array.push(ibLns, line.new(ibX1, ibL2, ibX2, ibL2, color=colIB, style=line.style_dotted))
            array.push(ibLbs, label.new(ibX1, ibM, "IB Mid", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colIB, 0), size=size.tiny))
            array.push(ibLbs, label.new(ibX1, ibH1, "IB High x1", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colIB, 0), size=size.tiny))
            array.push(ibLbs, label.new(ibX1, ibL1, "IB Low x1", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colIB, 0), size=size.tiny))
            array.push(ibLbs, label.new(ibX1, ibH2, "IB High x2", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colIB, 0), size=size.tiny))
            array.push(ibLbs, label.new(ibX1, ibL2, "IB Low x2", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colIB, 0), size=size.tiny))

// PDH/PDL som korta stubbar vid priset
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
var array<line>  pdLns = array.new_line()
var array<label> pdLbs = array.new_label()
if barstate.islast
    while array.size(pdLns) > 0
        line.delete(array.pop(pdLns))
    while array.size(pdLbs) > 0
        label.delete(array.pop(pdLbs))
    if showPD
        array.push(pdLns, line.new(bar_index - 4, pdh, bar_index + ibExt, pdh, color=colPD, width=1))
        array.push(pdLns, line.new(bar_index - 4, pdl, bar_index + ibExt, pdl, color=colPD, width=1))
        array.push(pdLbs, label.new(bar_index - 5, pdh, "PDH  " + str.tostring(pdh, format.mintick), style=label.style_label_right, color=color.new(color.black, 100), textcolor=color.new(colPD, 0), size=size.tiny))
        array.push(pdLbs, label.new(bar_index - 5, pdl, "PDL  " + str.tostring(pdl, format.mintick), style=label.style_label_right, color=color.new(color.black, 100), textcolor=color.new(colPD, 0), size=size.tiny))
    if showPrevVA and not na(lastVahP)
        array.push(pdLns, line.new(bar_index - 4, lastVahP, bar_index + ibExt, lastVahP, color=colVA, style=line.style_dotted, width=2))
        array.push(pdLns, line.new(bar_index - 4, lastValP, bar_index + ibExt, lastValP, color=colVA, style=line.style_dotted, width=2))
        array.push(pdLbs, label.new(bar_index - 5, lastVahP, "dVAH  " + str.tostring(lastVahP, format.mintick), style=label.style_label_right, color=color.new(color.black, 100), textcolor=colVA, size=size.tiny))
        array.push(pdLbs, label.new(bar_index - 5, lastValP, "dVAL  " + str.tostring(lastValP, format.mintick), style=label.style_label_right, color=color.new(color.black, 100), textcolor=colVA, size=size.tiny))

bool ibUpBar = false
bool ibDnBar = false
if showIB and ibLabels and ibDone and anchorIn and barstate.isconfirmed
    if close > ibHi and not ibUp
        ibUp := true
        ibUpBar := true
    if close < ibLo and not ibDn
        ibDn := true
        ibDnBar := true

// ════════════════════ VALUE AREA (TradingView-metoden) ════════════════════
f_va(array<float> bk, int poc, float tot, float vaF) =>
    int nR = array.size(bk)
    float vaVol = array.get(bk, poc)
    int up = poc
    int dn = poc
    int guard = 0
    while vaVol < tot * vaF and (up < nR - 1 or dn > 0) and guard < nR
        guard += 1
        float vUp = 0.0
        int nUp = 0
        if up + 1 <= nR - 1
            vUp += array.get(bk, up + 1)
            nUp := 1
            if up + 2 <= nR - 1
                vUp += array.get(bk, up + 2)
                nUp := 2
        float vDn = 0.0
        int nDn = 0
        if dn - 1 >= 0
            vDn += array.get(bk, dn - 1)
            nDn := 1
            if dn - 2 >= 0
                vDn += array.get(bk, dn - 2)
                nDn := 2
        if nUp > 0 and (nDn == 0 or vUp >= vDn)
            up += nUp
            vaVol += vUp
        else
            dn -= nDn
            vaVol += vDn
    [up, dn]

// ════════════════════ VOLUME PROFILE (sessionsdata) ════════════════════
var array<float> bHi  = array.new_float()
var array<float> bLo  = array.new_float()
var array<float> bVol = array.new_float()
var array<float> bBuy = array.new_float()
var int   sessStart = na
var float sHi = na
var float sLo = na

type SessProf
    float lo
    float step
    int   week
    array<float> bk
var array<SessProf> sessProfs = array.new<SessProf>()
var int   weekId = 0
var float lastWeekPoc = na

var float lastNS    = na
var float lastPocB  = na
var float lastProfB = na
var float lastPocP  = na

var array<polyline> sessPl = array.new<polyline>()

buildProfile() =>
    float retNS = na
    float retPocB = na
    float retProfB = na
    float retPocP = na
    float retVahP = na
    float retValP = na
    retBk = array.new_float(0)
    int n = array.size(bVol)
    if n > 0 and not na(sHi) and sHi > sLo
        float step = (sHi - sLo) / rows
        buckets = array.new_float(rows, 0.0)
        retBk := buckets
        dbuck   = array.new_float(rows, 0.0)
        float totBuy = 0.0
        float totAll = 0.0
        for i = 0 to n - 1
            hi = array.get(bHi, i)
            lo = array.get(bLo, i)
            v  = array.get(bVol, i)
            bv = array.get(bBuy, i)
            iLo = math.max(0, math.min(rows - 1, int(math.floor((lo - sLo) / step))))
            iHi = math.max(0, math.min(rows - 1, int(math.floor((hi - sLo) / step))))
            span = iHi - iLo + 1
            for j = iLo to iHi
                array.set(buckets, j, array.get(buckets, j) + v / span)
                array.set(dbuck,   j, array.get(dbuck,   j) + (2 * bv - v) / span)
            totBuy += bv
            totAll += v
        int pocIdx = 0
        float maxV = 0.0
        float totV = 0.0
        for j = 0 to rows - 1
            bvv = array.get(buckets, j)
            totV += bvv
            if bvv > maxV
                maxV := bvv
                pocIdx := j
        [vahIdx, valIdx] = f_va(buckets, pocIdx, totV, vaPct)
        retVahP := sLo + (vahIdx + 1) * step
        retValP := sLo + valIdx * step
        int sessLen = bar_index - sessStart
        float maxW = math.max(3, sessLen * widthPct)
        if showProf and profMode == "I sessionerna" and maxV > 0
            pts = array.new<chart.point>()
            array.push(pts, chart.point.from_index(sessStart, sLo))
            pva = array.new<chart.point>()
            array.push(pva, chart.point.from_index(sessStart, sLo + valIdx * step))
            for j = 0 to rows - 1
                int w = math.round(array.get(buckets, j) / maxV * maxW)
                array.push(pts, chart.point.from_index(sessStart + w, sLo + j * step))
                array.push(pts, chart.point.from_index(sessStart + w, sLo + (j + 1) * step))
                if j >= valIdx and j <= vahIdx
                    array.push(pva, chart.point.from_index(sessStart + w, sLo + j * step))
                    array.push(pva, chart.point.from_index(sessStart + w, sLo + (j + 1) * step))
            array.push(pts, chart.point.from_index(sessStart, sHi))
            array.push(pva, chart.point.from_index(sessStart, sLo + (vahIdx + 1) * step))
            array.push(sessPl, polyline.new(pts, closed=true, line_color=color.new(colProf, 100), fill_color=colProf))
            array.push(sessPl, polyline.new(pva, closed=true, line_color=color.new(colVAbar, 100), fill_color=colVAbar))
            while array.size(sessPl) > 90
                polyline.delete(array.shift(sessPl))
            int wPoc = math.round(array.get(buckets, pocIdx) / maxV * maxW)
            line.new(sessStart, sLo + (pocIdx + 0.5) * step, sessStart + wPoc, sLo + (pocIdx + 0.5) * step, color=colPOCbar, width=2)
        if showVA and profMode == "I sessionerna"
            line.new(sessStart, retVahP, bar_index, retVahP, color=colVA, width=1)
            line.new(sessStart, retValP, bar_index, retValP, color=colVA, width=1)
        float pocPrice = sLo + (pocIdx + 0.5) * step
        float pocVv  = array.get(buckets, pocIdx)
        float pocDl  = array.get(dbuck, pocIdx)
        retNS    := totV > 0 ? 100 * pocVv / totV : na
        retPocB  := pocVv > 0 ? 100 * (pocVv + pocDl) / (2 * pocVv) : na
        retProfB := totAll > 0 ? 100 * totBuy / totAll : na
        retPocP  := pocPrice
    [retNS, retPocB, retProfB, retPocP, retVahP, retValP, retBk]

f_weekPoc(int wk, array<float> extraBk, float extraLo, float extraStep) =>
    float ret = na
    float lo = na
    float hi = na
    for sp in sessProfs
        if sp.week == wk
            lo := na(lo) ? sp.lo : math.min(lo, sp.lo)
            hi := na(hi) ? sp.lo + sp.step * rows : math.max(hi, sp.lo + sp.step * rows)
    if array.size(extraBk) > 0
        lo := na(lo) ? extraLo : math.min(lo, extraLo)
        hi := na(hi) ? extraLo + extraStep * rows : math.max(hi, extraLo + extraStep * rows)
    if not na(lo) and hi > lo
        float step = (hi - lo) / rows
        wb = array.new_float(rows, 0.0)
        for sp in sessProfs
            if sp.week == wk
                for j = 0 to rows - 1
                    float v = array.get(sp.bk, j)
                    if v > 0
                        int idx = math.max(0, math.min(rows - 1, math.floor((sp.lo + (j + 0.5) * sp.step - lo) / step)))
                        array.set(wb, idx, array.get(wb, idx) + v)
        if array.size(extraBk) > 0
            for j = 0 to rows - 1
                float v = array.get(extraBk, j)
                if v > 0
                    int idx = math.max(0, math.min(rows - 1, math.floor((extraLo + (j + 0.5) * extraStep - lo) / step)))
                    array.set(wb, idx, array.get(wb, idx) + v)
        int pocIdx = 0
        float maxV = 0.0
        for j = 0 to rows - 1
            if array.get(wb, j) > maxV
                maxV := array.get(wb, j)
                pocIdx := j
        if maxV > 0
            ret := lo + (pocIdx + 0.5) * step
    ret

var array<box>   zBx = array.new<box>()
var array<line>  zLn = array.new<line>()
var array<label> zLb = array.new<label>()
var array<float> zLo = array.new<float>()
var array<float> zHi = array.new<float>()
var array<float> zVol = array.new<float>()
var array<float> zBuy = array.new<float>()
var array<int>   zStart = array.new<int>()

if newSess and not na(sessStart)
    [nsX, pbX, fbX, ppX, vhX, vlX, bkX] = buildProfile()
    lastNS    := nsX
    lastPocB  := pbX
    lastProfB := fbX
    lastPocP  := ppX
    lastVahP  := vhX
    lastValP  := vlX
    if array.size(bkX) == rows and sHi > sLo
        array.push(sessProfs, SessProf.new(sLo, (sHi - sLo) / rows, weekId, bkX))
        while array.size(sessProfs) > 14
            array.shift(sessProfs)
    if zoneOn and not na(ppX) and sHi > sLo
        float zStep = (sHi - sLo) / rows * zoneRowsN
        array.push(zBx, box.new(sessStart, ppX + zStep / 2, bar_index, ppX - zStep / 2, border_color=na, bgcolor=color.new(colZup, zoneTr)))
        array.push(zLn, line.new(sessStart, ppX, bar_index, ppX, color=colZup, style=line.style_dashed))
        array.push(zLb, label.new(bar_index, ppX, "", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colZup, size=size.small))
        array.push(zLo, ppX - zStep / 2)
        array.push(zHi, ppX + zStep / 2)
        array.push(zVol, array.sum(bVol))
        array.push(zBuy, nz(fbX, 50))
        array.push(zStart, sessStart)
        while array.size(zBx) > zoneMax
            box.delete(array.shift(zBx))
            line.delete(array.shift(zLn))
            label.delete(array.shift(zLb))
            array.shift(zLo)
            array.shift(zHi)
            array.shift(zVol)
            array.shift(zBuy)
            array.shift(zStart)

if newWeek and weekId > 0
    float wp = f_weekPoc(weekId, array.new_float(0), na, na)
    if not na(wp)
        lastWeekPoc := wp
if newWeek
    weekId += 1

if newSess
    array.clear(bHi)
    array.clear(bLo)
    array.clear(bVol)
    array.clear(bBuy)
    sessStart := bar_index
    sHi := high
    sLo := low

int nLtf = array.size(ltfV)
if nLtf > 0
    for k = 0 to nLtf - 1
        float hK = array.get(ltfH, k)
        float lK = array.get(ltfL, k)
        float vK = array.get(ltfV, k)
        float cK = array.get(ltfC, k)
        float rK = hK - lK
        array.push(bHi, hK)
        array.push(bLo, lK)
        array.push(bVol, vK)
        array.push(bBuy, rK > 0 ? vK * (cK - lK) / rK : vK * 0.5)
else
    array.push(bHi, high)
    array.push(bLo, low)
    array.push(bVol, volume)
    array.push(bBuy, buyVb)
sHi := na(sHi) ? high : math.max(sHi, high)
sLo := na(sLo) ? low  : math.min(sLo, low)

var float devWeekPoc = na
if barstate.islast
    devWeekPoc := na
    if showWeekDev and array.size(bVol) > 0 and sHi > sLo
        float cStep = (sHi - sLo) / rows
        cBk = array.new_float(rows, 0.0)
        for i = 0 to array.size(bVol) - 1
            int c0 = math.max(0, math.min(rows - 1, math.floor((array.get(bLo, i) - sLo) / cStep)))
            int c1 = math.max(0, math.min(rows - 1, math.floor((array.get(bHi, i) - sLo) / cStep)))
            float cs = array.get(bVol, i) / (c1 - c0 + 1)
            for j = c0 to c1
                array.set(cBk, j, array.get(cBk, j) + cs)
        devWeekPoc := f_weekPoc(weekId, cBk, sLo, cStep)

// ════════════════════ POC-ZONER: underhåll ════════════════════
f_volTxt(float v) =>
    v >= 1.0e6 ? str.tostring(v / 1.0e6, "#.##") + "M" : v >= 1.0e3 ? str.tostring(v / 1.0e3, "#.##") + "K" : str.tostring(v, "#")

if zoneKill and barstate.isconfirmed and array.size(zBx) > 0
    for i = array.size(zBx) - 1 to 0
        float lo = array.get(zLo, i)
        float hi = array.get(zHi, i)
        bool through = (close[1] < lo and close > hi) or (close[1] > hi and close < lo)
        if through
            box.delete(array.remove(zBx, i))
            line.delete(array.remove(zLn, i))
            label.delete(array.remove(zLb, i))
            array.remove(zLo, i)
            array.remove(zHi, i)
            array.remove(zVol, i)
            array.remove(zBuy, i)
            array.remove(zStart, i)

if barstate.islast and array.size(zBx) > 0
    int nZ = array.size(zBx)
    for i = 0 to nZ - 1
        float lo = array.get(zLo, i)
        float hi = array.get(zHi, i)
        float mid = (lo + hi) / 2
        bool below = mid < close
        color c = below ? colZup : colZdn
        int x2 = zoneExt ? bar_index : (i < nZ - 1 ? array.get(zStart, i + 1) : bar_index)
        box b = array.get(zBx, i)
        box.set_right(b, x2)
        box.set_bgcolor(b, color.new(c, zoneTr))
        line l = array.get(zLn, i)
        line.set_x2(l, x2)
        line.set_color(l, zoneMid ? c : color.new(c, 100))
        label lb = array.get(zLb, i)
        float bp = array.get(zBuy, i)
        bool bDom = bp >= 50
        string txt = zoneLbl ? str.tostring(nZ - i) + (nZ - i == 1 ? " session" : " sessioner") + " · Vol " + f_volTxt(array.get(zVol, i)) + " (" + str.tostring(bDom ? bp : 100 - bp, "#") + "% " + (bDom ? "B" : "S") + ")" : ""
        label.set_xy(lb, x2 + 3, mid)
        label.set_text(lb, txt)
        label.set_textcolor(lb, c)

// ════════════════════ DEVELOPING POC-SPÅR + HEATMAP ════════════════════
var array<chart.point> devPts = array.new<chart.point>()
var polyline devPl = na
var array<polyline> devHist = array.new<polyline>()
var array<box> heatBx = array.new<box>()
var array<box> heatOld = array.new<box>()
if newSess
    if not na(devPl)
        array.push(devHist, devPl)
        devPl := na
        while array.size(devHist) > zoneMax
            polyline.delete(array.shift(devHist))
    array.clear(devPts)
    if heatOn
        while array.size(heatBx) > 0
            array.push(heatOld, array.shift(heatBx))
        while array.size(heatOld) > devRows * (heatMax - 1)
            box.delete(array.shift(heatOld))
        for r = 0 to devRows - 1
            array.push(heatBx, box.new(bar_index, close, bar_index, close, border_color=na, bgcolor=color.new(color.black, 100)))

if (devOn or heatOn) and not na(sessStart) and sHi > sLo
    int nB = math.min(bar_index - sessStart + 1, 1500)
    float dStep = (sHi - sLo) / devRows
    dBk = array.new<float>(devRows, 0.0)
    float dMaxV = 0.0
    int dPoc = 0
    for i = 0 to nB - 1
        int r0 = math.max(0, math.min(devRows - 1, math.floor((low[i] - sLo) / dStep)))
        int r1 = math.max(0, math.min(devRows - 1, math.floor((high[i] - sLo) / dStep)))
        float sh = nz(volume[i]) / (r1 - r0 + 1)
        for r = r0 to r1
            float nv = array.get(dBk, r) + sh
            array.set(dBk, r, nv)
            if nv > dMaxV
                dMaxV := nv
                dPoc := r
    if devOn
        array.push(devPts, chart.point.from_index(bar_index, sLo + (dPoc + 0.5) * dStep))
        if not na(devPl)
            polyline.delete(devPl)
        devPl := polyline.new(devPts, curved=false, line_color=color.new(color.white, 20), line_width=2)
    if heatOn and array.size(heatBx) == devRows and dMaxV > 0
        for r = 0 to devRows - 1
            float it = array.get(dBk, r) / dMaxV
            color hc = it > 0.5 ? color.from_gradient(it, 0.5, 1.0, color.new(#00e5ff, heatTr), color.new(#ffc400, heatTr)) : color.from_gradient(it, 0.0, 0.5, color.new(#0a1a24, math.min(100, heatTr + 15)), color.new(#00e5ff, heatTr))
            box hb = array.get(heatBx, r)
            box.set_lefttop(hb, sessStart, sLo + (r + 1) * dStep)
            box.set_rightbottom(hb, bar_index, sLo + r * dStep)
            box.set_bgcolor(hb, hc)

// ════════════════════ POC-STUBBAR VID PRISET ════════════════════
var array<line>  pocStubLn = array.new_line()
var array<label> pocStubLb = array.new_label()
if barstate.islast
    while array.size(pocStubLn) > 0
        line.delete(array.pop(pocStubLn))
    while array.size(pocStubLb) > 0
        label.delete(array.pop(pocStubLb))
    if showStubs
        if not na(lastPocP)
            array.push(pocStubLn, line.new(bar_index - 4, lastPocP, bar_index + ibExt, lastPocP, color=colYpoc, width=2))
            array.push(pocStubLb, label.new(bar_index + ibExt, lastPocP, "Yesterday POC  " + str.tostring(lastPocP, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=colYpoc, size=size.tiny))
        if not na(lastWeekPoc)
            array.push(pocStubLn, line.new(bar_index - 4, lastWeekPoc, bar_index + ibExt, lastWeekPoc, color=colWpoc, width=2))
            array.push(pocStubLb, label.new(bar_index + ibExt, lastWeekPoc, "Last week POC  " + str.tostring(lastWeekPoc, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=colWpoc, size=size.tiny))
        if showWeekDev and not na(devWeekPoc)
            array.push(pocStubLn, line.new(bar_index - 4, devWeekPoc, bar_index + ibExt, devWeekPoc, color=colWpoc, style=line.style_dashed, width=1))
            array.push(pocStubLb, label.new(bar_index + ibExt, devWeekPoc, "This week POC  " + str.tostring(devWeekPoc, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colWpoc, 30), size=size.tiny))

// ════════════════════ HTF SWING HIGH/LOW ════════════════════
f_swing() =>
    float ph = ta.pivothigh(swLen, swLen)
    float pl = ta.pivotlow(swLen, swLen)
    float lastH = ta.valuewhen(not na(ph), ph, 0)
    float lastL = ta.valuewhen(not na(pl), pl, 0)
    [lastH, lastL]

[sw1H, sw1L] = request.security(syminfo.tickerid, swTf1, f_swing())
[sw2H, sw2L] = request.security(syminfo.tickerid, swTf2, f_swing())

f_tfTxt(string tf) =>
    tf == "60" ? "1H" : tf == "120" ? "2H" : tf == "240" ? "4H" : tf == "D" ? "1D" : tf == "W" ? "1W" : tf == "15" ? "15m" : tf == "30" ? "30m" : tf

var array<line>  swLns = array.new<line>()
var array<label> swLbs = array.new<label>()
if barstate.islast
    while array.size(swLns) > 0
        line.delete(array.pop(swLns))
    while array.size(swLbs) > 0
        label.delete(array.pop(swLbs))
    if swOn
        string t1 = f_tfTxt(swTf1)
        string t2 = f_tfTxt(swTf2)
        if swHighs and not na(sw1H)
            array.push(swLns, line.new(bar_index - 4, sw1H, bar_index + ibExt, sw1H, color=colSw1, width=2))
            array.push(swLbs, label.new(bar_index + ibExt, sw1H, t1 + " swing high  " + str.tostring(sw1H, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=colSw1, size=size.tiny))
        if swLows and not na(sw1L)
            array.push(swLns, line.new(bar_index - 4, sw1L, bar_index + ibExt, sw1L, color=colSw1, width=2))
            array.push(swLbs, label.new(bar_index + ibExt, sw1L, t1 + " swing low  " + str.tostring(sw1L, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=colSw1, size=size.tiny))
        if swHighs and not na(sw2H)
            array.push(swLns, line.new(bar_index - 4, sw2H, bar_index + ibExt, sw2H, color=colSw2, width=2))
            array.push(swLbs, label.new(bar_index + ibExt, sw2H, t2 + " swing high  " + str.tostring(sw2H, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=colSw2, size=size.tiny))
        if swLows and not na(sw2L)
            array.push(swLns, line.new(bar_index - 4, sw2L, bar_index + ibExt, sw2L, color=colSw2, width=2))
            array.push(swLbs, label.new(bar_index + ibExt, sw2L, t2 + " swing low  " + str.tostring(sw2L, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=colSw2, size=size.tiny))

bool swSweepUp = swOn and swHighs and ((not na(sw1H) and high > sw1H and high[1] <= sw1H) or (not na(sw2H) and high > sw2H and high[1] <= sw2H))
bool swSweepDn = swOn and swLows  and ((not na(sw1L) and low < sw1L and low[1] >= sw1L) or (not na(sw2L) and low < sw2L and low[1] >= sw2L))

// ════════════════════ ORDER BLOCKS (SMC / BOS) ════════════════════
color obUpEff  = color.new(colObUp, math.min(97, color.t(colObUp) + obTransp))
color obDnEff  = color.new(colObDn, math.min(97, color.t(colObDn) + obTransp))
color obUpTxtC = color.new(#00e5ff, math.min(90, 25 + obTransp))
color obDnTxtC = color.new(#ff2e88, math.min(90, 25 + obTransp))

var array<box>   obBx  = array.new<box>()
var array<int>   obDir = array.new<int>()
var array<float> obTop = array.new<float>()
var array<float> obBot = array.new<float>()

float volAvg = ta.sma(volume, 20)

f_obScore(bool isBull, float vSum, float move, int nBars) =>
    float body = math.abs(close - open)
    float volSc  = math.min(3.0, math.max(0.0, vSum / math.max(volAvg * nBars, 1.0) - 1.0))
    float dispSc = math.min(3.0, math.max(0.0, (move / math.max(atrF, syminfo.mintick) - math.max(obMult, 1.0)) * 1.67))
    float bodySc = math.min(2.0, math.max(0.0, (body / math.max(bRng, syminfo.mintick) - 0.5) * 4.0))
    float buyPct = bRng > 0 ? (close - low) / bRng : 0.5
    float dltSc  = math.min(2.0, math.max(0.0, ((isBull ? buyPct : 1.0 - buyPct) - 0.5) * 6.67))
    volSc + dispSc + bodySc + dltSc

f_gradeS(float sc) =>
    sc >= 7.5 ? " +++" : sc >= 5.5 ? " ++" : sc >= 3.5 ? " +" : ""

float obPh = ta.pivothigh(obPiv, obPiv)
float obPl = ta.pivotlow(obPiv, obPiv)
var float obLastPH = na
var float obLastPL = na
var int   obLastPHbar = na
var int   obLastPLbar = na
var bool  obPHbroken = true
var bool  obPLbroken = true
if not na(obPh)
    obLastPH := obPh
    obLastPHbar := bar_index - obPiv
    obPHbroken := false
if not na(obPl)
    obLastPL := obPl
    obLastPLbar := bar_index - obPiv
    obPLbroken := false

bool obTouchBar = false
if obOn and barstate.isconfirmed
    if array.size(obBx) > 0
        for j = array.size(obBx) - 1 to 0
            box b = array.get(obBx, j)
            int d = array.get(obDir, j)
            float t = array.get(obTop, j)
            float bo = array.get(obBot, j)
            box.set_right(b, bar_index)
            bool insideNow  = high >= bo and low <= t
            bool insidePrev = high[1] >= bo and low[1] <= t
            if insideNow and not insidePrev
                obTouchBar := true
            bool dead = d == 1 ? close < bo : close > t
            if dead
                box.delete(b)
                array.remove(obBx, j)
                array.remove(obDir, j)
                array.remove(obTop, j)
                array.remove(obBot, j)
    bool bosUp = not obPHbroken and not na(obLastPH) and (obConf == "Close" ? close > obLastPH : high > obLastPH)
    bool bosDn = not obPLbroken and not na(obLastPL) and (obConf == "Close" ? close < obLastPL : low  < obLastPL)
    if bosUp
        obPHbroken := true
    if bosDn
        obPLbroken := true
    if bosUp or bosDn
        int dirNew = bosUp ? 1 : -1
        int k = -1
        for i = 1 to obLook
            if (bosUp ? close[i] < open[i] : close[i] > open[i])
                k := i
                break
        if k > 0
            float tNew = obZone == "Body" ? math.max(open[k], close[k]) : high[k]
            float bNew = obZone == "Body" ? math.min(open[k], close[k]) : low[k]
            float move = bosUp ? close - low[k] : high[k] - close
            bool  dispOk = obMult <= 0 or move > obMult * atrF
            bool clash = false
            if array.size(obBx) > 0
                for j = 0 to array.size(obBx) - 1
                    if array.get(obDir, j) == dirNew and not (tNew < array.get(obBot, j) or bNew > array.get(obTop, j))
                        clash := true
            if dispOk and not clash
                float vSum = math.sum(volume, k + 1)
                float obSc = f_obScore(bosUp, vSum, move, k + 1)
                string txt = obTxt ? (bosUp ? "BULL OB" : "BEAR OB") + f_gradeS(obSc) + "  " + str.tostring(obSc, "#.#") + "/10\n" + f_volTxt(vSum) : ""
                box nb = box.new(bar_index - k, tNew, bar_index, bNew, border_color = na, bgcolor = bosUp ? obUpEff : obDnEff, text = txt, text_color = bosUp ? obUpTxtC : obDnTxtC, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
                array.push(obBx, nb)
                array.push(obDir, dirNew)
                array.push(obTop, tNew)
                array.push(obBot, bNew)
                if array.size(obBx) > obMaxN
                    box.delete(array.shift(obBx))
                    array.shift(obDir)
                    array.shift(obTop)
                    array.shift(obBot)
                if obBosLbl
                    float bosLvl = bosUp ? obLastPH : obLastPL
                    line.new(bosUp ? obLastPHbar : obLastPLbar, bosLvl, bar_index, bosLvl, color = bosUp ? color.new(#00e5ff, 50) : color.new(#ff2e88, 50), style = line.style_dashed, width = 1)
                    label.new(bar_index, bosLvl, "BOS", style = bosUp ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = bosUp ? color.new(#00e5ff, 20) : color.new(#ff2e88, 20), size = size.tiny)

// ════════════════════ HÖGERPROFIL (bar-index, funkar i helgluckor) ════════════════════
// Utjämning på en kopia.
f_smooth(array<float> a) =>
    out = array.copy(a)
    if smoothN > 0
        for j = 0 to rows - 1
            float acc = 0.0
            int cnt = 0
            for q = math.max(0, j - smoothN) to math.min(rows - 1, j + smoothN)
                acc += array.get(a, q)
                cnt += 1
            array.set(out, j, acc / cnt)
    out

// Breddskalning av ett enskilt värde.
f_sc(float v) =>
    profScale == "Kvadratrot" ? math.sqrt(v) : v

// Utjämning + kvadratrot på en kopia, för den delade profilens två sidor.
f_shape(array<float> a) =>
    out = f_smooth(a)
    if profScale == "Kvadratrot"
        for j = 0 to rows - 1
            array.set(out, j, math.sqrt(array.get(out, j)))
    out

// En sida (dir = 1 köp åt höger, -1 sälj åt vänster) för raderna j0..j1 som fylld polyline.
// Polylines i stället för en linje per rad: 400 rader × 2 sidor skulle spräcka max_lines_count.
f_sidePoly(array<float> d, int j0, int j1, float lo, float st, int xc, int dir, float dMx, int half, color c) =>
    pts = array.new<chart.point>()
    array.push(pts, chart.point.from_index(xc, lo + j0 * st))
    for j = j0 to j1
        int w = math.round(array.get(d, j) / dMx * half)
        array.push(pts, chart.point.from_index(xc + dir * w, lo + j * st))
        array.push(pts, chart.point.from_index(xc + dir * w, lo + (j + 1) * st))
    array.push(pts, chart.point.from_index(xc, lo + (j1 + 1) * st))
    polyline.new(pts, closed=true, line_color=color.new(c, 100), fill_color=c)

// Delta + Volym för raderna j0..j1: en tunn linje per rad, som i orderflow-plattformarnas profiler.
// Varje färg är en öppen polyline som går ut längs raden och tillbaka till mittlinjen innan den
// tar nästa rad, så att vägen mellan raderna hamnar på mittlinjen och inte syns. Det ger en linje
// per rad med bara fyra polylines, där 400 rader × 3 linjer skulle spräcka max_lines_count.
//  Höger: total volym. Röd linje ut till hela volymen, grön köpdel ovanpå från mittlinjen.
//  Vänster: deltat (köp − sälj). Grönt när köparna ledde på nivån, rött när säljarna gjorde det.
f_dvPolys(array<float> bb, array<float> ss, int j0, int j1, float lo, float st, int xc, int wV, int wD, float mT, float mD, color cB, color cS) =>
    pSell = array.new<chart.point>()
    pBuy  = array.new<chart.point>()
    pPos  = array.new<chart.point>()
    pNeg  = array.new<chart.point>()
    for j = j0 to j1
        float b = array.get(bb, j)
        float s = array.get(ss, j)
        float t = b + s
        float y = lo + (j + 0.5) * st
        int wT = t > 0 and mT > 0 ? math.round(math.min(1.0, f_sc(t) / mT) * wV) : 0
        int wB = t > 0 ? math.round(wT * b / t) : 0
        int wd = mD > 0 ? math.round(math.min(1.0, f_sc(math.abs(b - s)) / mD) * wD) : 0
        int wP = b >= s ? wd : 0
        int wN = b < s ? wd : 0
        array.push(pSell, chart.point.from_index(xc, y))
        array.push(pSell, chart.point.from_index(xc + wT, y))
        array.push(pSell, chart.point.from_index(xc, y))
        array.push(pBuy, chart.point.from_index(xc, y))
        array.push(pBuy, chart.point.from_index(xc + wB, y))
        array.push(pBuy, chart.point.from_index(xc, y))
        array.push(pPos, chart.point.from_index(xc, y))
        array.push(pPos, chart.point.from_index(xc - wP, y))
        array.push(pPos, chart.point.from_index(xc, y))
        array.push(pNeg, chart.point.from_index(xc, y))
        array.push(pNeg, chart.point.from_index(xc - wN, y))
        array.push(pNeg, chart.point.from_index(xc, y))
    res = array.new<polyline>()
    array.push(res, polyline.new(pSell, line_color=cS, line_width=1))
    array.push(res, polyline.new(pBuy, line_color=cB, line_width=1))
    array.push(res, polyline.new(pPos, line_color=cB, line_width=1))
    array.push(res, polyline.new(pNeg, line_color=cS, line_width=1))
    res

var array<box> rBoxes = array.new_box()
var array<line> rLines = array.new_line()
var array<label> rLabels = array.new_label()
var array<polyline> rPolys = array.new<polyline>()
if showProf and profMode == "Höger sida" and barstate.islast
    while array.size(rBoxes) > 0
        box.delete(array.pop(rBoxes))
    while array.size(rLines) > 0
        line.delete(array.pop(rLines))
    while array.size(rLabels) > 0
        label.delete(array.pop(rLabels))
    while array.size(rPolys) > 0
        polyline.delete(array.pop(rPolys))
    bool useSess = profSrc == "Pågående session" and array.size(bVol) > 0 and not na(sHi)
    int N = useSess ? 0 : math.min(lookback, bar_index + 1)
    float hh = useSess ? sHi : high
    float ll = useSess ? sLo : low
    if not useSess and N > 0
        for i = 0 to N - 1
            hh := math.max(hh, high[i])
            ll := math.min(ll, low[i])
    if hh > ll
        float step = (hh - ll) / rows
        buckets = array.new_float(rows, 0.0)
        buyBk   = array.new_float(rows, 0.0)
        if useSess
            for i = 0 to array.size(bVol) - 1
                int sLoI = math.max(0, math.min(rows - 1, int(math.floor((array.get(bLo, i) - ll) / step))))
                int sHiI = math.max(0, math.min(rows - 1, int(math.floor((array.get(bHi, i) - ll) / step))))
                float sShare = array.get(bVol, i) / (sHiI - sLoI + 1)
                float bShare = array.get(bBuy, i) / (sHiI - sLoI + 1)
                for j = sLoI to sHiI
                    array.set(buckets, j, array.get(buckets, j) + sShare)
                    array.set(buyBk, j, array.get(buyBk, j) + bShare)
        for i = 0 to math.max(N, 1) - 1
            if N == 0
                break
            hA = ltfH[i]
            lA = ltfL[i]
            vA = ltfV[i]
            cA = ltfC[i]
            int nK = array.size(vA)
            if nK > 0
                for k = 0 to nK - 1
                    float hK = array.get(hA, k)
                    float lK = array.get(lA, k)
                    float vK = array.get(vA, k)
                    float cK = array.get(cA, k)
                    float bK = hK > lK ? vK * (cK - lK) / (hK - lK) : vK * 0.5
                    int kLo = math.max(0, math.min(rows - 1, int(math.floor((lK - ll) / step))))
                    int kHi = math.max(0, math.min(rows - 1, int(math.floor((hK - ll) / step))))
                    int kSpan = kHi - kLo + 1
                    for j = kLo to kHi
                        array.set(buckets, j, array.get(buckets, j) + vK / kSpan)
                        array.set(buyBk, j, array.get(buyBk, j) + bK / kSpan)
            else
                iLo = math.max(0, math.min(rows - 1, int(math.floor((low[i] - ll) / step))))
                iHi = math.max(0, math.min(rows - 1, int(math.floor((high[i] - ll) / step))))
                span = iHi - iLo + 1
                for j = iLo to iHi
                    array.set(buckets, j, array.get(buckets, j) + volume[i] / span)
                    array.set(buyBk, j, array.get(buyBk, j) + buyVb[i] / span)
        int pocIdx = 0
        float maxV = 0.0
        float totV = 0.0
        for j = 0 to rows - 1
            bv = array.get(buckets, j)
            totV += bv
            if bv > maxV
                maxV := bv
                pocIdx := j
        [vahIdx, valIdx] = f_va(buckets, pocIdx, totV, vaPct)
        int x0 = bar_index + offBars
        int xE = x0 + profWbars
        bool dvMode = profType == "Delta + Volym"
        int half = math.max(5, int(profWbars / 2))
        int wDel = math.max(4, int(profWbars * deltaShare / 100))
        int xc = dvMode ? x0 + wDel : x0 + half
        sellBk = array.new_float(rows, 0.0)
        for j = 0 to rows - 1
            array.set(sellBk, j, math.max(0.0, array.get(buckets, j) - array.get(buyBk, j)))
        if profType == "Klassisk"
            disp = array.copy(buckets)
            float dMax = maxV
            if smoothN > 0
                dMax := 0.0
                for j = 0 to rows - 1
                    float acc = 0.0
                    int cnt = 0
                    for q = math.max(0, j - smoothN) to math.min(rows - 1, j + smoothN)
                        acc += array.get(buckets, q)
                        cnt += 1
                    float dv = acc / cnt
                    array.set(disp, j, dv)
                    dMax := math.max(dMax, dv)
            if profScale == "Kvadratrot"
                dMax := 0.0
                for j = 0 to rows - 1
                    float dv = math.sqrt(array.get(disp, j))
                    array.set(disp, j, dv)
                    dMax := math.max(dMax, dv)
            else if profScale == "Klipp topp 90%"
                srt = array.copy(disp)
                array.sort(srt, order.ascending)
                float cap = array.get(srt, math.min(rows - 1, int(rows * 0.9)))
                if cap > 0
                    dMax := cap
                    for j = 0 to rows - 1
                        array.set(disp, j, math.min(array.get(disp, j), cap))
            if dMax > 0
                for j = 0 to rows - 1
                    float dv = array.get(disp, j)
                    if dv > 0
                        int w = math.max(1, math.round(dv / dMax * profWbars))
                        float gap = step * rowGap / 200.0
                        float y1 = ll + j * step + gap
                        float y2 = ll + (j + 1) * step - gap
                        bool inVA = j >= valIdx and j <= vahIdx
                        color c = j == pocIdx ? colPOCbar : inVA ? colVAbar : colProf
                        if drawStyle == "Boxar"
                            array.push(rBoxes, box.new(xE - w, y2, xE, y1, border_color=na, bgcolor=c))
                        else
                            float yM = ll + (j + 0.5) * step
                            array.push(rLines, line.new(xE - w, yM, xE, yM, color=color.new(c, math.max(0, color.t(c) - 20)), width=1))
        else if dvMode
            sB = f_smooth(buyBk)
            sS = f_smooth(sellBk)
            // Volymsidan och deltasidan skalas var för sig: deltat är alltid mycket mindre än volymen.
            tSc = array.new_float(rows, 0.0)
            dSc = array.new_float(rows, 0.0)
            for j = 0 to rows - 1
                float b = array.get(sB, j)
                float s = array.get(sS, j)
                array.set(tSc, j, f_sc(b + s))
                array.set(dSc, j, f_sc(math.abs(b - s)))
            float mT = array.max(tSc)
            float mD = array.max(dSc)
            if profScale == "Klipp topp 90%"
                array.sort(tSc, order.ascending)
                array.sort(dSc, order.ascending)
                mT := array.get(tSc, math.min(rows - 1, int(rows * 0.9)))
                mD := array.get(dSc, math.min(rows - 1, int(rows * 0.9)))
            int wVol = xE - xc
            // Utanför value area tonas ner.
            color bOut = color.new(colBuyP, math.min(95, color.t(colBuyP) + 50))
            color sOut = color.new(colSellP, math.min(95, color.t(colSellP) + 50))
            if mT > 0
                if valIdx > 0
                    plLo = f_dvPolys(sB, sS, 0, valIdx - 1, ll, step, xc, wVol, wDel, mT, mD, bOut, sOut)
                    array.concat(rPolys, plLo)
                plVa = f_dvPolys(sB, sS, valIdx, vahIdx, ll, step, xc, wVol, wDel, mT, mD, colBuyP, colSellP)
                array.concat(rPolys, plVa)
                if vahIdx < rows - 1
                    plHi = f_dvPolys(sB, sS, vahIdx + 1, rows - 1, ll, step, xc, wVol, wDel, mT, mD, bOut, sOut)
                    array.concat(rPolys, plHi)
            array.push(rLines, line.new(xc, ll, xc, hh, color=color.new(color.gray, 20), width=1))
            // Siffror per nivå: deltat till vänster, total volym till höger.
            if numGroups > 0
                int g = math.min(numGroups, rows)
                for gi = 0 to g - 1
                    int a0 = int(gi * rows / g)
                    int a1 = math.max(a0, int((gi + 1) * rows / g) - 1)
                    float gb = 0.0
                    float gs = 0.0
                    for j = a0 to a1
                        gb += array.get(buyBk, j)
                        gs += array.get(sellBk, j)
                    if gb + gs > 0
                        float gy = ll + (a0 + a1 + 1) / 2.0 * step
                        float gd = gb - gs
                        array.push(rLabels, label.new(xc - 1, gy, (gd >= 0 ? "+" : "-") + f_volTxt(math.abs(gd)), style=label.style_label_right, color=color.new(color.black, 100), textcolor=color.new(gd >= 0 ? colBuyP : colSellP, 0), size=size.tiny))
                        array.push(rLabels, label.new(xc + 1, gy, f_volTxt(gb + gs), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(color.gray, 10), size=size.tiny))
        else
            // Delad profil: säljare åt vänster, köpare åt höger. Båda sidor skalas mot samma max
            // så att en sida som är dubbelt så bred också har dubbelt så mycket volym.
            dB = f_shape(buyBk)
            dS = f_shape(sellBk)
            float dMx = math.max(array.max(dB), array.max(dS))
            if profScale == "Klipp topp 90%"
                srt = array.concat(array.copy(dB), dS)
                array.sort(srt, order.ascending)
                float cap = array.get(srt, math.min(array.size(srt) - 1, int(array.size(srt) * 0.9)))
                if cap > 0
                    dMx := cap
                    for j = 0 to rows - 1
                        array.set(dB, j, math.min(array.get(dB, j), cap))
                        array.set(dS, j, math.min(array.get(dS, j), cap))
            if dMx > 0
                // Utanför value area tonas ner, precis som i den klassiska profilen.
                color bOut = color.new(colBuyP, math.min(95, color.t(colBuyP) + 45))
                color sOut = color.new(colSellP, math.min(95, color.t(colSellP) + 45))
                if valIdx > 0
                    array.push(rPolys, f_sidePoly(dB, 0, valIdx - 1, ll, step, xc, 1, dMx, half, bOut))
                    array.push(rPolys, f_sidePoly(dS, 0, valIdx - 1, ll, step, xc, -1, dMx, half, sOut))
                array.push(rPolys, f_sidePoly(dB, valIdx, vahIdx, ll, step, xc, 1, dMx, half, colBuyP))
                array.push(rPolys, f_sidePoly(dS, valIdx, vahIdx, ll, step, xc, -1, dMx, half, colSellP))
                if vahIdx < rows - 1
                    array.push(rPolys, f_sidePoly(dB, vahIdx + 1, rows - 1, ll, step, xc, 1, dMx, half, bOut))
                    array.push(rPolys, f_sidePoly(dS, vahIdx + 1, rows - 1, ll, step, xc, -1, dMx, half, sOut))
            array.push(rLines, line.new(xc, ll, xc, hh, color=color.new(color.gray, 30), width=1))
            // Siffror per nivå: raderna slås ihop till numGroups nivåer, sälj till vänster och köp till höger.
            if numGroups > 0
                int g = math.min(numGroups, rows)
                for gi = 0 to g - 1
                    int a0 = int(gi * rows / g)
                    int a1 = math.max(a0, int((gi + 1) * rows / g) - 1)
                    float gb = 0.0
                    float gs = 0.0
                    for j = a0 to a1
                        gb += array.get(buyBk, j)
                        gs += array.get(sellBk, j)
                    if gb + gs > 0
                        float gy = ll + (a0 + a1 + 1) / 2.0 * step
                        array.push(rLabels, label.new(xc - 1, gy, "-" + f_volTxt(gs), style=label.style_label_right, color=color.new(color.black, 100), textcolor=color.new(colSellP, 0), size=size.tiny))
                        array.push(rLabels, label.new(xc + 1, gy, "+" + f_volTxt(gb), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(colBuyP, 0), size=size.tiny))
        // Delta överst och total underst — samma siffror som Delta/Total i orderflow-profiler.
        if showDT and totV > 0
            float totB = array.sum(buyBk)
            float totS = totV - totB
            float dPct = 100 * (totB - totS) / totV
            color dCol = dPct >= 0 ? colBuyP : colSellP
            // Utan bakgrundsruta: bara text, så att den inte tar över bilden.
            array.push(rLabels, label.new(xc, hh, "Delta " + (dPct >= 0 ? "+" : "") + str.tostring(dPct, "#.##") + "%  " + (dPct >= 0 ? "+" : "-") + f_volTxt(math.abs(totB - totS)), style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.new(dCol, 0), size=size.small))
            array.push(rLabels, label.new(xc, ll, "Volym " + f_volTxt(totV) + "   Köp " + f_volTxt(totB) + " / Sälj " + f_volTxt(totS), style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.new(color.gray, 10), size=size.small))
        float pocP = ll + (pocIdx + 0.5) * step
        float vahP = ll + (vahIdx + 1) * step
        float valP = ll + valIdx * step
        bool thin = profType != "Klassisk"
        array.push(rLines, line.new(x0, pocP, xE, pocP, color=colPOC, width=thin ? 1 : 3))
        array.push(rLines, line.new(x0, vahP, xE, vahP, color=colVA, style=thin ? line.style_dashed : line.style_dotted, width=thin ? 1 : 2))
        array.push(rLines, line.new(x0, valP, xE, valP, color=colVA, style=thin ? line.style_dashed : line.style_dotted, width=thin ? 1 : 2))
        array.push(rLines, line.new(x0, hh, xE, hh, color=color.new(color.gray, 40), style=line.style_dotted))
        array.push(rLines, line.new(x0, ll, xE, ll, color=color.new(color.gray, 40), style=line.style_dotted))
        array.push(rLabels, label.new(xE + 1, pocP, "POC", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colPOC, size=size.small))
        array.push(rLabels, label.new(xE + 1, vahP, "VAH", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colVA, size=size.small))
        array.push(rLabels, label.new(xE + 1, valP, "VAL", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colVA, size=size.small))
        array.push(rLabels, label.new(xE + 1, hh, "HIGH", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(color.gray, 20), size=size.tiny))
        array.push(rLabels, label.new(xE + 1, ll, "LOW", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(color.gray, 20), size=size.tiny))

// ════════════════════ TRENDMOLN ════════════════════
efT = ta.ema(close, fLen)
esT = ta.ema(close, sLen)
bool bullBias = efT >= esT
c1 = plot(showCloud ? efT : na, "EMA snabb", color=color.new(color.gray, 100))
c2 = plot(showCloud ? esT : na, "EMA långsam", color=color.new(color.gray, 100))
fill(c1, c2, color=showCloud ? (bullBias ? colBull : colBear) : na)

// Extremkanal
chU = ta.highest(high[1], chLen)
chL = ta.lowest(low[1], chLen)
pChU = plot(showCh ? chU : na, "Kanal övre", color=colCh, style=plot.style_stepline)
pChL = plot(showCh ? chL : na, "Kanal undre", color=colCh, style=plot.style_stepline)
fill(pChU, pChL, color=showCh and fillCh ? colChFill : na)

// ════════════════════ DASHBOARD (4 rader) ════════════════════
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 25), border_width=1, border_color=color.new(color.gray, 70))
if barstate.islast and showDash
    color dUp = color.new(#00e5ff, 0)
    color dDn = color.new(#f23645, 0)
    color dMut = color.new(color.gray, 20)
    float sBuy = array.size(bBuy) > 0 ? array.sum(bBuy) : na
    float sTot = array.size(bVol) > 0 ? array.sum(bVol) : na
    float sSell = na(sBuy) ? na : sTot - sBuy
    float sDelta = na(sBuy) or sTot <= 0 ? na : 100 * (sBuy - sSell) / sTot
    table.cell(dash, 0, 0, "VWAP", text_color=dMut, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 0, na(vwap) ? "–" : (close >= vwap ? "ÖVER " : "UNDER ") + str.tostring(math.abs(100 * (close - vwap) / vwap), "#.##") + "%", text_color=close >= vwap ? dUp : dDn, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 1, "TREND", text_color=dMut, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, bullBias ? "UPP" : "NED", text_color=bullBias ? dUp : dDn, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 2, "Y-POC", text_color=colYpoc, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, na(lastPocP) ? "–" : str.tostring(lastPocP, format.mintick), text_color=na(lastPocP) ? dMut : close >= lastPocP ? dUp : dDn, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 3, "DELTA", text_color=dMut, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, na(sDelta) ? "–" : (sDelta >= 0 ? "+" : "") + str.tostring(sDelta, "#.#") + "%", text_color=na(sDelta) ? dMut : sDelta >= 0 ? dUp : dDn, text_size=size.small, text_halign=text.align_right)

// ════════════════════ ALERTS ════════════════════
alertcondition(obTouchBar, "Order Block touch", "Priset har gått in i ett aktivt order block")
alertcondition(ibUpBar, "IB breakout upp", "Stängning över IB High")
alertcondition(ibDnBar, "IB breakout ned", "Stängning under IB Low")
alertcondition(swSweepUp, "HTF swing high tagen", "Priset har gått över en HTF swing high")
alertcondition(swSweepDn, "HTF swing low tagen", "Priset har gått under en HTF swing low")

// ==================== CANDLE-FÄRGER ====================
barcolor(paintBars ? (close >= open ? colCup : colCdn) : na)

// ==================== VATTENSTÄMPEL ====================
var table wm = table.new(position.bottom_right, 1, 1)
if barstate.islast
    bool noVol = cumVolAll == 0
    table.cell(wm, 0, 0, noVol ? "GRABIT — INGEN VOLYMDATA · byt till futures (MNQ1!/MGC1!)" : "GRABIT", text_color=noVol ? color.new(#f23645, 0) : color.new(color.gray, 60), text_size=size.small)
