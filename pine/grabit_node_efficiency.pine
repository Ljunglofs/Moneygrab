//@version=6
// GRABIT — Node Efficiency (NE)
// ---------------------------------------------------------------------------
// Nollcentrerad oscillator som mäter hur effektivt priset rör sig genom volym.
// Tänkt att ligga under GRABIT NBE: nodmotorn säger VAR, den här säger HUR
// HÅRT. En avvisning vid POC med djupt ineffektivt tryck är en annan sak än
// samma avvisning mitt i en effektiv impuls.
//
// VAD DEN MÄTER
//  Fyra delar vägs ihop och normaliseras till ett nollcentrerat värde:
//   1. Priseffektivitet — nettorörelse delat med vägens längd. Nära 1 betyder
//      att priset gick rakt, nära 0 att det sågade sig fram lika långt.
//   2. Effektiv volym vid noden — volymen viktad med hur nära VWAP baren låg.
//      Volym nära värdet är acceptans, volym långt ifrån är förflyttning.
//   3. Orderflödesobalans — köp/sälj ur barens egen form, utjämnad. Samma
//      approximation som i grabit_delta_cvd.pine, inte licensierad orderflow.
//   4. Avkastningsvolatilitet — normaliserar rörelsen mot rådande regim, så
//      att en lika stor rörelse väger tyngre i en lugn marknad.
//
// LÄSNING
//  Höga positiva värden = effektiv impuls uppåt, alltså risk att jaga.
//  Djupt negativa värden = ineffektivt tryck, det som oftast reverterar.
//  Tröskelvärdena ±4.6 i förval är samma som förlagan uppger som sina.
//  Det är ett kontextlager, aldrig en entry i sig.
//
// RITAR INTE OM
//  Inga request.security-anrop, ingen lookahead, signaler på bekräftad bar.
// ---------------------------------------------------------------------------
indicator("GRABIT Node Efficiency", "GRABIT NE", overlay = false, precision = 2)

// ════════════════════════ INPUTS ════════════════════════
const string G_C = "Beräkning"
int   effLen = input.int(20,  "Effektivitetsfönster (bars)", minval = 3, maxval = 200, group = G_C,
     tooltip = "Över hur många barer nettorörelsen jämförs med vägens längd.")
int   imbLen = input.int(14,  "Utjämning av obalans", minval = 1, maxval = 100, group = G_C)
int   volLen = input.int(100, "Fönster för volym och volatilitet", minval = 20, maxval = 500, group = G_C)
float proxK  = input.float(2.0, "VWAP-närhet (xATR)", minval = 0.2, maxval = 10.0, step = 0.1, group = G_C,
     tooltip = "Hur brett fönstret runt VWAP är innan volymen räknas som förflyttning i stället för acceptans.")
float wImb   = input.float(0.5, "Vikt: orderflödesobalans", minval = 0.0, maxval = 2.0, step = 0.1, group = G_C)
float wVol   = input.float(0.5, "Vikt: effektiv volym", minval = 0.0, maxval = 2.0, step = 0.1, group = G_C)
int   zLen   = input.int(200, "Normaliseringsfönster", minval = 30, maxval = 1000, group = G_C,
     tooltip = "Över hur lång historik värdet centreras och skalas. Kortare fönster ger fler extremvärden.")
int   smLen  = input.int(3, "Utjämning av resultatet", minval = 1, maxval = 20, group = G_C)

const string G_Z = "Zoner"
float effHi  = input.float(4.6,  "Effektiv zon (över)", step = 0.1, group = G_Z)
float effLo  = input.float(-4.6, "Ineffektiv zon (under)", step = 0.1, group = G_Z)
bool  sigRev = input.bool(true, "Signal när värdet lämnar en zon", group = G_Z,
     tooltip = "Markerar när trycket släpper: uppåt ut ur den ineffektiva zonen, nedåt ut ur den effektiva. Det är en reversionsläsning, inte en trendläsning.")
bool  showMid = input.bool(true, "Mittband (±0.05)", group = G_Z)

const string G_V = "Utseende"
bool  showHist = input.bool(true, "Histogram", group = G_V)
bool  showLine = input.bool(true, "Linje", group = G_V)
bool  showDash = input.bool(true, "Statusruta", group = G_V)
color colPos   = input.color(color.new(#00e5ff, 0),  "Positiv", group = G_V)
color colNeg   = input.color(color.new(#ff2e88, 0),  "Negativ", group = G_V)
color colEff   = input.color(color.new(#00e676, 82), "Effektiv zon", group = G_V)
color colIneff = input.color(color.new(#f23645, 82), "Ineffektiv zon", group = G_V)

// ════════════════════════ BERÄKNING ════════════════════════
float atr14 = ta.atr(14)
float vw    = ta.vwap(hlc3)
float vol   = nz(volume)

// 1. Priseffektivitet: hur rak vägen var, signerad -1..1
float netMove = close - close[effLen]
float path    = math.sum(math.abs(close - close[1]), effLen)
float effR    = path > 0 ? netMove / path : 0.0

// 2. Effektiv volym: volym viktad med närheten till VWAP
float dist  = atr14 > 0 ? math.abs(close - vw) / atr14 : 0.0
float prox  = 1.0 / (1.0 + dist / math.max(proxK, 0.1))
float evol  = vol * prox
float evolA = ta.sma(evol, volLen)
float evolS = ta.stdev(evol, volLen)
float evolZ = evolS > 0 ? (evol - evolA) / evolS : 0.0

// 3. Orderflödesobalans ur barens form
float rngB   = high - low
float buyV   = rngB > 0 ? vol * (close - low) / rngB : vol * 0.5
float imbRaw = vol > 0 ? (2 * buyV - vol) / vol : 0.0
float imb    = ta.ema(imbRaw, imbLen)

// 4. Volatilitetsnormaliserad förflyttning
float ret1 = close[1] != 0 ? close / close[1] - 1 : 0.0
float vola = ta.stdev(ret1, volLen)
float disp = vola > 0 and close[effLen] != 0 ? (close / close[effLen] - 1) / (vola * math.sqrt(effLen)) : 0.0

// Sammanvägning. Beloppet av effektiviteten skalar den signerade
// förflyttningen, så riktningen kommer från rörelsen och inte från vikterna.
// Faktorerna golvas så att en extrem volymavvikelse inte kan vända tecknet.
float imbF = math.max(0.1, 1.0 + wImb * imb)
float volF = math.max(0.1, 1.0 + wVol * evolZ)
float core = math.abs(effR) * disp * imbF * volF

float coreA = ta.sma(core, zLen)
float coreS = ta.stdev(core, zLen)
float raw   = coreS > 0 ? (core - coreA) / coreS : 0.0
float ne    = smLen > 1 ? ta.ema(raw, smLen) : raw

// ════════════════════════ TILLSTÅND ════════════════════════
bool inEff   = ne >= effHi
bool inIneff = ne <= effLo
string state = inEff ? "EFFEKTIV" : inIneff ? "INEFFEKTIV" : ne >= 0 ? "NEUTRAL +" : "NEUTRAL −"

bool leaveIneff = sigRev and barstate.isconfirmed and ne > effLo and ne[1] <= effLo
bool leaveEff   = sigRev and barstate.isconfirmed and ne < effHi and ne[1] >= effHi

// ════════════════════════ RITNING ════════════════════════
color barCol = ne >= 0 ? color.new(colPos, inEff ? 0 : 45) : color.new(colNeg, inIneff ? 0 : 45)
plot(showHist ? ne : na, "NE histogram", color = barCol, style = plot.style_histogram, linewidth = 2)
plot(showLine ? ne : na, "NE", color = color.new(#7f8ca6, 20), linewidth = 1)

hline(0, "Noll", color = color.new(color.gray, 55), linestyle = hline.style_dotted)
hEff = hline(effHi, "Effektiv", color = color.new(#00e676, 45), linestyle = hline.style_dashed)
hIne = hline(effLo, "Ineffektiv", color = color.new(#f23645, 45), linestyle = hline.style_dashed)
hTop = hline(1000,  "", color = color.new(color.gray, 100))
hBot = hline(-1000, "", color = color.new(color.gray, 100))
fill(hEff, hTop, color = colEff,   title = "Effektiv zon")
fill(hIne, hBot, color = colIneff, title = "Ineffektiv zon")
hline( 0.05, "Mitt +", color = showMid ? color.new(color.gray, 78) : color.new(color.gray, 100), linestyle = hline.style_dotted)
hline(-0.05, "Mitt −", color = showMid ? color.new(color.gray, 78) : color.new(color.gray, 100), linestyle = hline.style_dotted)

plotshape(leaveIneff ? effLo : na, "Tryck släpper uppåt", shape.triangleup,   location.absolute, colPos, size = size.tiny)
plotshape(leaveEff   ? effHi : na, "Tryck släpper nedåt", shape.triangledown, location.absolute, colNeg, size = size.tiny)

var table dash = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 22), border_width = 1, border_color = color.new(color.gray, 72))
if barstate.islast and showDash
    color mut = color.new(color.gray, 20)
    color sc  = inEff ? color.new(#00e676, 0) : inIneff ? color.new(#f23645, 0) : mut
    table.cell(dash, 0, 0, "LÄGE", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, state, text_color = sc, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 1, "NE", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, str.tostring(ne, "#.##"), text_color = ne >= 0 ? colPos : colNeg, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 2, "EFFEKTIVITET", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, str.tostring(100 * math.abs(effR), "#") + "% rak", text_color = mut, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 3, "OBALANS", text_color = mut, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, (imb >= 0 ? "+" : "") + str.tostring(100 * imb, "#") + "%", text_color = imb >= 0 ? colPos : colNeg, text_size = size.small, text_halign = text.align_right)

var table wm = table.new(position.bottom_right, 1, 1)
if barstate.islast
    bool noVol = ta.cum(vol) == 0
    table.cell(wm, 0, 0, noVol ? "GRABIT NE — INGEN VOLYMDATA" : "GRABIT NE",
         text_color = noVol ? color.new(#f23645, 0) : color.new(color.gray, 60), text_size = size.small)

// ════════════════════════ LARM ════════════════════════
alertcondition(leaveIneff, "NE: tryck släpper uppåt", "GRABIT NE: lämnar den ineffektiva zonen")
alertcondition(leaveEff,   "NE: tryck släpper nedåt", "GRABIT NE: lämnar den effektiva zonen")
alertcondition(ne <= effLo and ne[1] > effLo, "NE: in i ineffektiv zon", "GRABIT NE: ineffektivt tryck")
alertcondition(ne >= effHi and ne[1] < effHi, "NE: in i effektiv zon", "GRABIT NE: effektiv impuls")
