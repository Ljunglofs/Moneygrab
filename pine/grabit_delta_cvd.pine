// GRABIT Delta · CVD
// ---------------------------------------------------------------------------
// Volymdelta och kumulativ delta (CVD) för NQ/GC — vem som faktiskt lyfter
// priset, köpare eller säljare.
//
// SÅ HÄR RÄKNAS DET:
//  Varje bar delas upp i intrabarer (t.ex. 5-sekunders på en 5-minutersgraf).
//  Varje intrabar klassas som köp om den stängde upp och sälj om den stängde
//  ner, och dess volym får motsvarande tecken. Summan är barens delta, och
//  summan över dagen är CVD. Det är samma metod som TradingViews egen
//  volymdelta — en approximation av bid/ask-flöde, inte licensierad orderflow,
//  men på NQ och GC ligger den mycket nära.
//
// SÅ HÄR ANVÄNDS DET:
//  CVD-ljusen visar både nivå och riktning: kroppen är barens delta, nivån är
//  dagens ackumulerade. Ligger CVD över signallinjen och stiger har köparna
//  övertaget. Divergens — priset gör ny topp men CVD lägre topp — betyder att
//  lyftet saknar köpare bakom sig, och tvärtom i botten.
//
// Lägg till på samma graf som GRABIT GEX Levels: väggen säger var, deltat
// säger om någon orkar dit.
// ---------------------------------------------------------------------------
//@version=6
indicator("GRABIT Delta · CVD", overlay = false, format = format.volume, precision = 0)

// ── Inmatning ──────────────────────────────────────────────────────────────
const string G_CALC = "Beräkning"
string ltfIn = input.string("Auto", "Intrabar-upplösning", options = ["Auto", "1S", "5S", "10S", "15S", "1", "5"], group = G_CALC,
     tooltip = "Auto väljer efter grafens tidsram. Finare upplösning ger exaktare delta men TradingView begränsar hur många intrabarer som får hämtas — får du tomma barer bakåt, ta en grövre.")
string anchor = input.string("Dag", "Nollställ CVD", options = ["Dag", "Vecka", "Session (RTH)", "Aldrig"], group = G_CALC,
     tooltip = "Dag: CVD börjar om vid varje ny handelsdag. Session: vid RTH-öppning. Aldrig: löpande sedan grafens början.")
int sigLen = input.int(21, "Signallinje (EMA)", minval = 2, maxval = 200, group = G_CALC)

const string G_VIEW = "Vy"
string mode = input.string("Ljus", "CVD som", options = ["Ljus", "Linje"], group = G_VIEW)
bool showSig = input.bool(true, "Signallinje", group = G_VIEW)
bool showTbl = input.bool(true, "Statusruta", group = G_VIEW)
bool showDiv = input.bool(true, "Markera divergenser", group = G_VIEW)
int  divLen  = input.int(5, "Divergens — pivotlängd", minval = 2, maxval = 25, group = G_VIEW,
     tooltip = "Antal barer på var sida om en topp/botten. Lägre = fler och tidigare signaler.")
bool useAlerts = input.bool(true, "Larm vid divergens och deltavändning", group = G_VIEW)

color cUp   = input.color(#26A69A, "Köpare", group = "Färger", inline = "c")
color cDn   = input.color(#EF5350, "Säljare", group = "Färger", inline = "c")
color cSig  = input.color(#F0B90B, "Signallinje", group = "Färger", inline = "c")

// ── Intrabar-upplösning ────────────────────────────────────────────────────
// Hålls som simple string hela vägen — request.security_lower_tf tar inte ett
// värde som räknats fram per bar.
int    chartSec = timeframe.in_seconds(timeframe.period)
string ltfAuto  = chartSec <= 60 ? "1S" : chartSec <= 300 ? "5S" : chartSec <= 900 ? "15S" : chartSec <= 3600 ? "1" : "5"
string LTF      = ltfIn == "Auto" ? ltfAuto : ltfIn

[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, LTF, [open, close, volume])

// ── Delta per bar + intrabarens högsta/lägsta ackumulering ─────────────────
float barDelta = 0.0
float runHi = 0.0
float runLo = 0.0
int   nIntra = na(ltfC) ? 0 : array.size(ltfC)

if nIntra > 0
    float run = 0.0
    for i = 0 to nIntra - 1
        float o = array.get(ltfO, i)
        float c = array.get(ltfC, i)
        float v = nz(array.get(ltfV, i))
        float d = c > o ? v : c < o ? -v : 0.0
        run += d
        runHi := math.max(runHi, run)
        runLo := math.min(runLo, run)
    barDelta := run
else
    // Ingen intrabar-data (för långt bakåt eller symbol utan volym) — klassa hela baren.
    barDelta := close > open ? nz(volume) : close < open ? -nz(volume) : 0.0
    runHi := math.max(0.0, barDelta)
    runLo := math.min(0.0, barDelta)

// ── Nollställning ──────────────────────────────────────────────────────────
bool reset = switch anchor
    "Dag"            => timeframe.change("D")
    "Vecka"          => timeframe.change("W")
    "Session (RTH)"  => session.isfirstbar_regular
    => false

var float cvd = 0.0
float cvdOpen  = (reset or na(cvd[1])) ? 0.0 : cvd[1]
float cvdClose = cvdOpen + barDelta
float cvdHigh  = cvdOpen + runHi
float cvdLow   = cvdOpen + runLo
cvd := cvdClose

float sig = ta.ema(cvdClose, sigLen)

// ── Rita ───────────────────────────────────────────────────────────────────
color cBar = barDelta >= 0 ? cUp : cDn
plotcandle(mode == "Ljus" ? cvdOpen : na, mode == "Ljus" ? cvdHigh : na,
     mode == "Ljus" ? cvdLow : na, mode == "Ljus" ? cvdClose : na,
     title = "CVD", color = cBar, bordercolor = cBar, wickcolor = color.new(cBar, 40))
plot(mode == "Linje" ? cvdClose : na, "CVD-linje", color = cBar, linewidth = 2, style = plot.style_line)
plot(showSig ? sig : na, "Signal", color = cSig, linewidth = 1)
hline(0, "Noll", color = color.new(#7A7A85, 40), linestyle = hline.style_dotted)

// ── Divergenser ────────────────────────────────────────────────────────────
float ph = ta.pivothigh(high, divLen, divLen)
float pl = ta.pivotlow(low, divLen, divLen)

var float lastPH = na
var float lastPHc = na
var float lastPL = na
var float lastPLc = na
bool divBear = false
bool divBull = false

if not na(ph)
    float c0 = cvdClose[divLen]
    divBear := not na(lastPH) and ph > lastPH and c0 < lastPHc
    lastPH := ph
    lastPHc := c0

if not na(pl)
    float c1 = cvdClose[divLen]
    divBull := not na(lastPL) and pl < lastPL and c1 > lastPLc
    lastPL := pl
    lastPLc := c1

if showDiv and divBear
    label.new(bar_index - divLen, cvdClose[divLen], "Säljare absorberar", style = label.style_label_down,
         color = color.new(cDn, 15), textcolor = #0B0B0D, size = size.small)
if showDiv and divBull
    label.new(bar_index - divLen, cvdClose[divLen], "Köpare absorberar", style = label.style_label_up,
         color = color.new(cUp, 15), textcolor = #0B0B0D, size = size.small)

// ── Statusruta ─────────────────────────────────────────────────────────────
f_vol(float v) =>
    float a = math.abs(v)
    string s = a >= 1000000 ? str.tostring(v / 1000000, "#.##") + "M" : a >= 1000 ? str.tostring(v / 1000, "#.#") + "K" : str.tostring(v, "#")
    s

bool bull = cvdClose > sig and cvdClose > cvdClose[1]
bool bear = cvdClose < sig and cvdClose < cvdClose[1]
string bias = bull ? "KÖPARE" : bear ? "SÄLJARE" : "JÄMNT"
color  cBias = bull ? cUp : bear ? cDn : #7A7A85

var table tb = table.new(position.top_right, 2, 4, bgcolor = color.new(#131316, 10), border_width = 1, border_color = color.new(#2A2A31, 40))
if barstate.islast and showTbl
    table.cell(tb, 0, 0, "DELTA", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 0, (barDelta >= 0 ? "+" : "") + f_vol(barDelta), text_color = cBar,
         text_size = size.small, text_formatting = text.format_bold)
    table.cell(tb, 0, 1, "CVD", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 1, (cvdClose >= 0 ? "+" : "") + f_vol(cvdClose),
         text_color = cvdClose >= 0 ? cUp : cDn, text_size = size.small, text_formatting = text.format_bold)
    table.cell(tb, 0, 2, "ÖVERTAG", text_color = #7A7A85, text_size = size.small)
    table.cell(tb, 1, 2, bias, text_color = #0B0B0D, bgcolor = cBias, text_size = size.small, text_formatting = text.format_bold)
    table.cell(tb, 0, 3, "INTRABAR", text_color = #7A7A85, text_size = size.tiny)
    table.cell(tb, 1, 3, nIntra > 0 ? LTF + " · " + str.tostring(nIntra) : "saknas — grov beräkning",
         text_color = nIntra > 0 ? #7A7A85 : cDn, text_size = size.tiny)

// ── Larm ───────────────────────────────────────────────────────────────────
if useAlerts and barstate.isconfirmed
    if divBear
        alert("GRABIT Delta · " + syminfo.ticker + ": ny topp i priset utan ny topp i CVD — säljare absorberar", alert.freq_once_per_bar)
    if divBull
        alert("GRABIT Delta · " + syminfo.ticker + ": ny botten i priset utan ny botten i CVD — köpare absorberar", alert.freq_once_per_bar)
    if barDelta > 0 and barDelta[1] <= 0
        alert("GRABIT Delta · " + syminfo.ticker + ": delta vände positivt (" + f_vol(barDelta) + ")", alert.freq_once_per_bar)
    if barDelta < 0 and barDelta[1] >= 0
        alert("GRABIT Delta · " + syminfo.ticker + ": delta vände negativt (" + f_vol(barDelta) + ")", alert.freq_once_per_bar)
