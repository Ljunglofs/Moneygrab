// GRABIT GEX Levels · NQ/MNQ & GC/MGC
// ---------------------------------------------------------------------------
// Ritar GEX-nivåerna från GRABIT-räknaren (python gex_cli.py, /tvgex i Telegram
// eller /desk/gexstring). Bara GEX — inga andra nivåer.
//
// SÅ HÄR:
//  1. Pine Editor -> klistra in -> Add to chart (NQ1!, MNQ1!, GC1!, MGC1!).
//  2. Skriv /tvgex all i Telegram (eller öppna /desk/gexstring?inst=all).
//  3. Inställningar -> klistra in NQ-strängen i "NQ — levels string" och
//     GC-strängen i "GC — levels string". Market = Auto väljer rätt efter grafen.
//  4. Valfritt: larm på indikatorn ("Any alert() function call") ger notis när
//     priset korsar Call Wall, Put Wall, 0DTE-väggarna, Flip eller HGEX.
//
// LAYOUT: förvalet "Ren" visar tre linjer — Call Wall, Gamma Flip, Put Wall —
// med prispiller i högerkanten och en statusrad överst. "Nyckelnivåer" lägger
// till HGEX, Max Pain och EM±, "Alla" resten (0DTE, G+/G−, IV-range, ATR-grid).
//
// Strängformat: pris,etikett,typ;pris,etikett,typ;...
// Typer: res sup res0 sup0 flip hgex mpain gpos gneg emh eml emb ivh ivl opo opu opd
// ---------------------------------------------------------------------------
//@version=6
indicator("GRABIT GEX Levels", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Inmatning ──────────────────────────────────────────────────────────────
const string G_SRC = "GEX-strängar (från /tvgex)"
string market = input.string("Auto", "Market", options = ["Auto", "NQ", "GC"], group = G_SRC,
     tooltip = "Auto: NQ/MNQ/NDX/US100 -> NQ-strängen, GC/MGC/XAU -> GC-strängen.")
string srcNQ  = input.string("", "NQ — levels string", group = G_SRC)
string srcGC  = input.string("", "GC — levels string", group = G_SRC)
bool   useSrc = input.bool(true, "Visa GEX-nivåer", group = G_SRC)
float  pxOff  = input.float(0.0, "Prisjustering (punkter)", step = 0.25, group = G_SRC,
     tooltip = "0 normalt. Använd bara om din feed (t.ex. CFD) ligger systematiskt bredvid futurespriset.")

const string G_VIEW = "Vy"
string preset = input.string("Ren", "Nivåer", options = ["Ren", "Nyckelnivåer", "Alla"], group = G_VIEW,
     tooltip = "Ren: Call Wall, Gamma Flip, Put Wall. Nyckelnivåer: + HGEX, Max Pain, EM±. Alla: + 0DTE, G+/G−, IV-range och ATR-grid.")
bool   showSec  = input.bool(true, "Andra väggen (CW2 / PW2)", group = G_VIEW,
     tooltip = "En extra nivå per håll: närmaste positiva gamma-strike ovanför priset (CW2) och närmaste negativa under (PW2). I vyn Alla visas i stället alla G+/G− med sina egna namn.")
bool   showHdr  = input.bool(true, "Statusrad överst", group = G_VIEW)
bool   showTags = input.bool(true, "Prispiller i högerkanten", group = G_VIEW)
bool   showPx   = input.bool(true, "Piller för aktuellt pris", group = G_VIEW)

const string G_STYLE = "Utseende"
string theme = input.string("GRABIT", "Färgtema", options = ["GRABIT", "Klassisk"], group = G_STYLE,
     tooltip = "GRABIT: Call Wall röd (tak), Put Wall lila (golv). Klassisk: Call Wall grön, Put Wall röd.")
int    wKey   = input.int(2, "Linjebredd väggar", minval = 1, maxval = 5, group = G_STYLE)
string tagSz  = input.string("Small", "Textstorlek", options = ["Tiny", "Small", "Normal", "Large"], group = G_STYLE)
int    tagOff = input.int(8, "Avstånd till kanten (barer)", minval = 1, maxval = 60, group = G_STYLE)
bool   extBoth = input.bool(false, "Förläng linjer bakåt också", group = G_STYLE)
bool   useAlerts = input.bool(true, "Larm vid korsning av väggar/flip/HGEX", group = G_STYLE)

// ── Färger ─────────────────────────────────────────────────────────────────
color cCall = theme == "Klassisk" ? #26A69A : #EF5350
color cPut  = theme == "Klassisk" ? #EF5350 : #AB47BC
color cFlip = #F0B90B
color cSoft = #8A8A94
color cInk  = #0B0B0D
color cBg   = #131316

// ── Marknad ────────────────────────────────────────────────────────────────
f_market() =>
    string m = market
    if m == "Auto"
        string s = str.upper(syminfo.root + " " + syminfo.ticker)
        m := str.contains(s, "GC") or str.contains(s, "XAU") or str.contains(s, "GOLD") ? "GC" : "NQ"
    m

string src = useSrc ? (f_market() == "GC" ? srcGC : srcNQ) : ""

// ── Vilka typer som visas ──────────────────────────────────────────────────
f_isCore(string k) =>
    k == "res" or k == "sup" or k == "flip"

f_isKey(string k) =>
    f_isCore(k) or k == "hgex" or k == "mpain" or k == "emh" or k == "eml"

f_show(string k) =>
    bool sec = (k == "gpos" or k == "gneg") and showSec
    switch preset
        "Ren"           => f_isCore(k) or sec
        "Nyckelnivåer"  => f_isKey(k) or sec
        => true

// ── Utseende per typ ───────────────────────────────────────────────────────
f_col(string k) =>
    switch k
        "res"   => cCall
        "res0"  => cCall
        "gpos"  => cCall
        "sup"   => cPut
        "sup0"  => cPut
        "gneg"  => cPut
        "flip"  => cFlip
        "hgex"  => cFlip
        "mpain" => color.new(cFlip, 40)
        "emh"   => cSoft
        "eml"   => cSoft
        "emb"   => color.new(cSoft, 55)
        "ivh"   => color.new(cSoft, 35)
        "ivl"   => color.new(cSoft, 35)
        "opo"   => color.new(cFlip, 35)
        "opu"   => color.new(cSoft, 60)
        "opd"   => color.new(cSoft, 60)
        => cSoft

f_width(string k) =>
    switch k
        "res"  => wKey
        "sup"  => wKey
        "flip" => math.max(1, wKey - 1)
        "hgex" => 2
        => 1

f_style(string k) =>
    switch k
        "res"  => line.style_solid
        "sup"  => line.style_solid
        "hgex" => line.style_solid
        "flip" => line.style_dashed
        "res0" => line.style_dashed
        "sup0" => line.style_dashed
        "gpos" => line.style_dashed
        "gneg" => line.style_dashed
        => line.style_dotted

// Kort kod i pillret — CW 29686 i stället för hela etiketten.
// isSec = nivån är den valda andra väggen (närmast priset på sin sida).
f_code(string k, string tag, bool isSec) =>
    switch k
        "res"   => "CW"
        "sup"   => "PW"
        "res0"  => "CW 0DTE"
        "sup0"  => "PW 0DTE"
        "flip"  => "ZG"
        "hgex"  => "HGEX"
        "mpain" => "MP"
        "gpos"  => isSec ? "CW2" : str.replace_all(tag, " ", "")
        "gneg"  => isSec ? "PW2" : str.replace_all(tag, " ", "")
        "emh"   => "EM+"
        "eml"   => "EM−"
        "emb"   => "EM½"
        "ivh"   => "IV+"
        "ivl"   => "IV−"
        "opo"   => "OPEN"
        "opu"   => "ATR+"
        "opd"   => "ATR−"
        => tag

f_sz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

f_bold(string k) =>
    f_isCore(k) ? text.format_bold : text.format_none

// ── Parsa strängen en gång ─────────────────────────────────────────────────
var array<float>  aP = array.new<float>()
var array<string> aT = array.new<string>()
var array<string> aK = array.new<string>()
var string parsedSrc = ""

if barstate.islast and src != parsedSrc
    array.clear(aP)
    array.clear(aT)
    array.clear(aK)
    parsedSrc := src
    if str.length(src) > 0
        array<string> rows = str.split(src, ";")
        for r in rows
            array<string> f = str.split(r, ",")
            if array.size(f) == 3
                float p = str.tonumber(str.trim(array.get(f, 0)))
                if not na(p)
                    array.push(aP, p + pxOff)
                    array.push(aT, str.trim(array.get(f, 1)))
                    array.push(aK, str.trim(array.get(f, 2)))

// ── Rita ───────────────────────────────────────────────────────────────────
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()

if barstate.islast
    for l in lns
        line.delete(l)
    array.clear(lns)
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)

    // Andra väggen: närmaste positiva gamma-strike ovanför priset och närmaste
    // negativa under. G+/G− kommer sorterade efter gammastorlek, inte pris, så
    // utan det här steget hamnar CW2 under CW1.
    int secUp = -1
    int secDn = -1
    float upBest = na
    float dnBest = na
    if array.size(aP) > 0
        for i = 0 to array.size(aP) - 1
            string kk = array.get(aK, i)
            float pp = array.get(aP, i)
            if kk == "gpos" and pp > close and (na(upBest) or pp < upBest)
                upBest := pp
                secUp := i
            if kk == "gneg" and pp < close and (na(dnBest) or pp > dnBest)
                dnBest := pp
                secDn := i

    if array.size(aP) > 0
        for i = 0 to array.size(aP) - 1
            string k = array.get(aK, i)
            float p = array.get(aP, i)
            bool isSec = (k == "gpos" and i == secUp) or (k == "gneg" and i == secDn)
            bool show = f_show(k)
            if k == "gpos" or k == "gneg"
                show := preset == "Alla" ? true : (showSec and isSec)
            if show and not na(p)
                color c = f_col(k)
                array.push(lns, line.new(bar_index - 1, p, bar_index, p,
                     extend = extBoth ? extend.both : extend.right,
                     color = c, width = f_width(k), style = f_style(k)))
                if showTags
                    string code = f_code(k, array.get(aT, i), isSec)
                    array.push(lbs, label.new(bar_index + tagOff, p,
                         code + "  " + str.tostring(p, format.mintick),
                         style = label.style_label_left, color = c, textcolor = cInk,
                         size = f_sz(tagSz), textalign = text.align_left,
                         text_formatting = f_bold(k)))

    if showPx
        array.push(lbs, label.new(bar_index + tagOff, close,
             str.tostring(close, format.mintick), style = label.style_label_left,
             color = #E8E6E1, textcolor = cInk, size = f_sz(tagSz),
             text_formatting = text.format_bold))

// ── Statusrad ──────────────────────────────────────────────────────────────
f_lvl(string kind) =>
    float out = na
    if array.size(aP) > 0
        for i = 0 to array.size(aP) - 1
            if array.get(aK, i) == kind and na(out)
                out := array.get(aP, i)
    out

var table hdr = table.new(position.top_center, 6, 1, bgcolor = color.new(cBg, 10),
     border_width = 1, border_color = color.new(#2A2A31, 40))

if barstate.islast
    table.clear(hdr, 0, 0, 5, 0)
    if showHdr and array.size(aP) > 0
        float cw = f_lvl("res")
        float pw = f_lvl("sup")
        float zg = f_lvl("flip")
        bool  hasZ = not na(zg)
        bool  pos = hasZ and close > zg
        string und = f_market() == "GC" ? "GLD" : "QQQ"
        table.cell(hdr, 0, 0, und + " → " + f_market(), text_color = cSoft, text_size = size.small)
        table.cell(hdr, 1, 0, str.tostring(close, format.mintick), text_color = #E8E6E1,
             text_size = size.small, text_formatting = text.format_bold)
        table.cell(hdr, 2, 0, na(cw) ? "C –" : "C " + str.tostring(cw, format.mintick),
             text_color = cCall, text_size = size.small)
        table.cell(hdr, 3, 0, na(zg) ? "Z –" : "Z " + str.tostring(zg, format.mintick),
             text_color = cFlip, text_size = size.small)
        table.cell(hdr, 4, 0, na(pw) ? "P –" : "P " + str.tostring(pw, format.mintick),
             text_color = cPut, text_size = size.small)
        if hasZ
            table.cell(hdr, 5, 0, pos ? "POSITIV GAMMA" : "NEGATIV GAMMA",
                 text_color = cInk, bgcolor = pos ? #26A69A : #EF5350,
                 text_size = size.small, text_formatting = text.format_bold)

// ── Larm ───────────────────────────────────────────────────────────────────
if useAlerts and barstate.isconfirmed and array.size(aP) > 0
    for i = 0 to array.size(aP) - 1
        string k = array.get(aK, i)
        if f_isCore(k) or k == "hgex" or k == "res0" or k == "sup0"
            float lv = array.get(aP, i)
            bool up = close[1] < lv and close >= lv
            bool dn = close[1] > lv and close <= lv
            if up or dn
                alert("GRABIT GEX · " + f_market() + " korsade " + array.get(aT, i) + " @ " + str.tostring(lv, format.mintick) + (up ? " ▲" : " ▼"), alert.freq_once_per_bar)
