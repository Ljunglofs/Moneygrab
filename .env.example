# GRABIT · miljövariabler
#
#   cp .env.example .env    och fyll i på servern. .env ska ALDRIG committas —
#   repot är publikt. Den ligger i .gitignore.
#
# Hämta värdena från Render: Dashboard -> grabit-api -> Environment. Allt som
# inte står här har en förnuftig standard i koden och kan lämnas tomt.

# ---- Servern ------------------------------------------------------------
# Domänen appen ska svara på. Caddy tar ut certifikatet för exakt den här.
DOMAIN=grabit.dittnamn.duckdns.org
# Mejl till Let's Encrypt (varning innan certifikat går ut). Får vara tomt.
TLS_EMAIL=

# ---- Telegram (gammalarm, robotlarm) ------------------------------------
TELEGRAM_TOKEN=
CHAT_ID=

# ---- TradingView -> appen -----------------------------------------------
# Samma hemlighet som ligger i larm-URL:en i TradingView (?key=...).
TV_WEBHOOK_SECRET=
# 1 = släpp bara igenom TradingViews IP-adresser. Kräver att Caddy skickar
# X-Forwarded-For, vilket den gör i Caddyfile ovan.
TV_IP_CHECK=0

# ---- AI-texterna ---------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Push till mobilen (PWA) --------------------------------------------
# Samma nycklar som i dag, annars måste alla prenumerera om sig.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUB=mailto:din@mejl.se

# ---- Kursdata och order --------------------------------------------------
FINNHUB_API_KEY=
FMP_API_KEY=
ALPACA_KEY=
ALPACA_SECRET=

# ---- Övrigt --------------------------------------------------------------
DISCORD_WEBHOOK_URL=
ROBBER_ADMIN_KEY=
ROBBER_QUICK_CODE=
PRO_UNLOCK_CODES=

# ---- Desk ---------------------------------------------------------------
# Gammatimern i desk.py. GEX-nivåerna skickas redan av GitHub Actions, så den
# behövs bara om du vill ha dem från appen också.
DESK_GEX_TIMER=0
DESK_PUSH=1
